      "html": "\n<div class=\"bg-[#FFFAFA] min-h-[1200px] font-body text-[#003262] p-6 lg:p-10 relative overflow-hidden\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=DM+Sans:wght@400;500;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --color-snow: #FFFAFA;\n            --color-platinum: #F2F3F4;\n            --color-navy: #003262;\n            --color-emerald: #50C878;\n        }\n\n        .font-heading { font-family: 'Inter', sans-serif; }\n        .font-body { font-family: 'DM Sans', sans-serif; }\n\n        .swiss-grid {\n            background-image: radial-gradient(circle, #e5e7eb 1px, transparent 1px);\n            background-size: 24px 24px;\n        }\n\n        .shimmer {\n            background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);\n            background-size: 200% 100%;\n            animation: shimmer 2s infinite linear;\n        }\n\n        @keyframes shimmer {\n            from { background-position: -100% 0; }\n            to { background-position: 100% 0; }\n        }\n\n        .pulse-emerald {\n            box-shadow: 0 0 0 0 rgba(80, 200, 120, 0.4);\n            animation: pulse-emerald 2s infinite;\n        }\n\n        @keyframes pulse-emerald {\n            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(80, 200, 120, 0.7); }\n            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(80, 200, 120, 0); }\n            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(80, 200, 120, 0); }\n        }\n    </style>\n\n    \n    <nav class=\"flex items-center justify-between mb-10 gap-8\" data-kid=\"2\">\n        <div class=\"flex items-center gap-3 shrink-0\" data-kid=\"3\">\n            <div class=\"w-12 h-12 bg-[var(--color-navy)] rounded-xl flex items-center justify-center text-white shadow-xl shadow-navy-900/10\" data-kid=\"4\">\n                <i class=\"ti ti-globe text-3xl\" data-kid=\"5\"></i>\n            </div>\n            <div data-kid=\"6\">\n                <h1 class=\"font-heading font-extrabold text-2xl tracking-tight leading-none text-[var(--color-navy)]\" data-kid=\"7\">SLB<span class=\"text-[var(--color-emerald)]\" data-kid=\"8\">.</span></h1>\n                <p class=\"text-[9px] font-heading font-bold tracking-[0.25em] text-gray-400 mt-1.5 uppercase\" data-kid=\"9\">Swiss Logistics Board</p>\n            </div>\n        </div>\n\n        <div class=\"flex-1 max-w-3xl\" data-kid=\"10\">\n            <div class=\"relative group\" data-kid=\"11\">\n                <div class=\"absolute inset-y-0 left-5 flex items-center pointer-events-none\" data-kid=\"12\">\n                    <i class=\"ti ti-search text-gray-400 text-xl group-focus-within:text-[var(--color-navy)] transition-colors\" data-kid=\"13\"></i>\n                </div>\n                <input type=\"text\" placeholder=\"Search Global Manifests, Vessels, or Terminal IDs...\" class=\"w-full bg-white border border-gray-200 rounded-2xl py-4 pl-14 pr-24 shadow-sm focus:outline-hidden focus:ring-4 focus:ring-[var(--color-navy)]/5 focus:border-[var(--color-navy)] transition-all font-body text-sm font-medium\" data-kid=\"14\">\n                <div class=\"absolute right-5 inset-y-0 flex items-center gap-2\" data-kid=\"15\">\n                    <kbd class=\"hidden md:inline-block px-2 py-1 text-[10px] font-bold text-gray-400 bg-gray-50 border border-gray-200 rounded-md\" data-kid=\"16\">CMD</kbd>\n                    <kbd class=\"hidden md:inline-block px-2 py-1 text-[10px] font-bold text-gray-400 bg-gray-50 border border-gray-200 rounded-md\" data-kid=\"17\">K</kbd>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"flex items-center gap-6 shrink-0\" data-kid=\"18\">\n            <div class=\"hidden xl:flex flex-col items-end mr-2\" data-kid=\"19\">\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"20\">Global Status</p>\n                <p class=\"text-[11px] font-heading font-bold text-[var(--color-emerald)] flex items-center gap-1.5\" data-kid=\"21\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--color-emerald)] animate-pulse\" data-kid=\"22\"></span> OPERATIONAL\n                </p>\n            </div>\n            <button class=\"relative w-11 h-11 rounded-xl bg-white border border-gray-200 flex items-center justify-center text-gray-500 hover:text-[var(--color-navy)] hover:border-[var(--color-navy)] transition-all cursor-pointer\" data-kid=\"23\">\n                <i class=\"ti ti-bell text-xl\" data-kid=\"24\"></i>\n                <span class=\"absolute top-2.5 right-2.5 w-2 h-2 bg-[var(--color-emerald)] border-2 border-white rounded-full\" data-kid=\"25\"></span>\n            </button>\n            <div class=\"h-10 w-[1px] bg-gray-200\" data-kid=\"26\"></div>\n            <div class=\"flex items-center gap-3 cursor-pointer group\" data-kid=\"27\">\n                <div class=\"text-right\" data-kid=\"28\">\n                    <p class=\"text-xs font-heading font-bold text-[var(--color-navy)] group-hover:underline\" data-kid=\"29\">K. Mueller</p>\n                    <p class=\"text-[10px] font-body text-gray-400 font-bold uppercase tracking-wider\" data-kid=\"30\">Shift Lead</p>\n                </div>\n                <div class=\"relative\" data-kid=\"31\">\n                    <img src=\"https://i.pravatar.cc/100?u=mueller\" alt=\"User\" class=\"w-11 h-11 rounded-xl object-cover border-2 border-white shadow-md\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n                    <div class=\"absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[var(--color-emerald)] border-2 border-white rounded-full\" data-kid=\"33\"></div>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    \n    <div class=\"relative w-full h-[600px] bg-[var(--color-platinum)] rounded-3xl border border-gray-200 mb-8 overflow-hidden swiss-grid\" data-kid=\"34\">\n        \n        <svg class=\"absolute inset-0 w-full h-full opacity-20 pointer-events-none\" viewBox=\"0 0 1440 600\" data-kid=\"35\">\n            <path d=\"M100,100 C300,50 400,150 600,100 S900,200 1200,150 S1400,250 1440,200\" fill=\"none\" stroke=\"var(--color-navy)\" stroke-width=\"1.5\" stroke-dasharray=\"4 4\" data-kid=\"36\"></path>\n            <path d=\"M50,450 C250,500 450,400 650,450 S950,550 1250,480 S1440,400 1440,420\" fill=\"none\" stroke=\"var(--color-navy)\" stroke-width=\"1.5\" stroke-dasharray=\"8 8\" data-kid=\"37\"></path>\n            <path d=\"M200,200 Q400,400 600,250 T1000,400\" fill=\"none\" stroke=\"var(--color-navy)\" stroke-width=\"1\" opacity=\"0.5\" data-kid=\"38\"></path>\n        </svg>\n\n        \n        <div class=\"absolute top-[25%] left-[28%] flex flex-col items-center group cursor-pointer\" data-kid=\"39\">\n            <div class=\"bg-[var(--color-emerald)] p-1.5 rounded-full shadow-lg pulse-emerald z-10\" data-kid=\"40\">\n                <i class=\"ti ti-map-pin text-white text-lg\" data-kid=\"41\"></i>\n            </div>\n            <div class=\"mt-2 bg-white/95 backdrop-blur-md px-3 py-1.5 rounded-lg shadow-xl border border-gray-100 opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100\" data-kid=\"42\">\n                <p class=\"text-[10px] font-bold text-[var(--color-navy)]\" data-kid=\"43\">ZURICH HUB (HQ)</p>\n                <div class=\"flex items-center gap-2 mt-0.5\" data-kid=\"44\">\n                    <p class=\"text-[9px] text-[var(--color-emerald)] font-bold\" data-kid=\"45\">ACTIVE: 142</p>\n                    <span class=\"w-[1px] h-2 bg-gray-200\" data-kid=\"46\"></span>\n                    <p class=\"text-[9px] text-gray-500 font-bold\" data-kid=\"47\"><i class=\"ti ti-sun text-orange-400 mr-0.5\" data-kid=\"48\"></i> 14°C</p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"absolute top-[45%] left-[42%] flex flex-col items-center group cursor-pointer\" data-kid=\"49\">\n            <div class=\"bg-[var(--color-navy)] p-1.5 rounded-full shadow-lg z-10\" data-kid=\"50\">\n                <i class=\"ti ti-map-pin text-white text-lg\" data-kid=\"51\"></i>\n            </div>\n            <div class=\"mt-2 bg-white px-3 py-1.5 rounded-lg shadow-xl border border-gray-100 opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100\" data-kid=\"52\">\n                <p class=\"text-[10px] font-bold text-[var(--color-navy)]\" data-kid=\"53\">MARSEILLE PORT</p>\n                <p class=\"text-[9px] text-gray-500 font-bold\" data-kid=\"54\">WAITING: 8 Vessels</p>\n            </div>\n        </div>\n\n        <div class=\"absolute top-[65%] left-[78%] flex flex-col items-center group cursor-pointer\" data-kid=\"55\">\n            <div class=\"bg-[var(--color-emerald)] p-1.5 rounded-full shadow-lg pulse-emerald z-10\" data-kid=\"56\">\n                <i class=\"ti ti-map-pin text-white text-lg\" data-kid=\"57\"></i>\n            </div>\n            <div class=\"mt-2 bg-white px-3 py-1.5 rounded-lg shadow-xl border border-gray-100 opacity-0 group-hover:opacity-100 transition-all scale-90 group-hover:scale-100\" data-kid=\"58\">\n                <p class=\"text-[10px] font-bold text-[var(--color-navy)]\" data-kid=\"59\">SINGAPORE TERMINAL</p>\n                <p class=\"text-[9px] text-[var(--color-emerald)] font-bold\" data-kid=\"60\">OPERATING: 100%</p>\n            </div>\n        </div>\n\n        <div class=\"absolute top-[35%] left-[85%] flex flex-col items-center group cursor-pointer\" data-kid=\"61\">\n            <div class=\"bg-red-500 p-1.5 rounded-full shadow-lg z-10\" data-kid=\"62\">\n                <i class=\"ti ti-map-pin text-white text-lg\" data-kid=\"63\"></i>\n            </div>\n            <div cl