      "html": "\n<div class=\"min-h-screen bg-[#F0F0F0] text-[#222222] font-['IBM_Plex_Mono'] overflow-x-hidden\" data-kid=\"0\">\n  \n  \n  <header id=\"topbar-grid\" class=\"w-full bg-[#F0F0F0] border-b-4 border-[#222] flex sticky top-0 z-50\" data-kid=\"1\">\n    <div class=\"border-r-4 border-[#222] px-8 py-4 flex items-center gap-3 bg-[#4285F4] text-white\" data-kid=\"2\">\n      <i class=\"ti ti-box text-2xl\" data-kid=\"3\"></i>\n      <span class=\"font-['Syne'] font-extrabold text-2xl tracking-tighter\" data-kid=\"4\">KONSTRUKT.OPS</span>\n    </div>\n    \n    <div class=\"flex-grow border-r-4 border-[#222] px-6 py-4 flex items-center\" data-kid=\"5\">\n      <div class=\"w-full flex items-center gap-4\" data-kid=\"6\">\n        <i class=\"ti ti-search text-xl text-[#222]/60\" data-kid=\"7\"></i>\n        <input type=\"text\" placeholder=\"CMD_SEARCH_OPERATIONS...\" class=\"w-full bg-transparent outline-none placeholder-[#222]/40 text-sm font-bold uppercase tracking-wider\" data-kid=\"8\">\n      </div>\n    </div>\n\n    <div class=\"hidden lg:flex border-r-4 border-[#222] px-6 py-4 items-center gap-3\" data-kid=\"9\">\n      <div class=\"w-3 h-3 bg-[#34A853] rounded-full shadow-[0_0_12px_rgba(52,168,83,0.6)] animate-pulse\" data-kid=\"10\"></div>\n      <span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"11\">Network_Core: Online</span>\n    </div>\n\n    <div class=\"border-r-4 border-[#222] px-6 py-4 flex items-center gap-8\" data-kid=\"12\">\n      <div class=\"text-right\" data-kid=\"13\">\n        <div class=\"text-[9px] font-bold opacity-50 leading-none\" data-kid=\"14\">UPTIME</div>\n        <div class=\"text-xs font-bold leading-tight\" data-kid=\"15\">124D:12H:09M</div>\n      </div>\n      <div class=\"text-right\" data-kid=\"16\">\n        <div class=\"text-[9px] font-bold opacity-50 leading-none\" data-kid=\"17\">LATENCY</div>\n        <div class=\"text-xs font-bold leading-tight\" data-kid=\"18\">12.4ms</div>\n      </