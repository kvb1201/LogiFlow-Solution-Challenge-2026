"lazy\" data-kid=\"128\">\n            <img class=\"inline-block h-8 w-8 rounded-full ring-4 ring-white\" src=\"https://i.pravatar.cc/100?u=2\" alt decoding=\"async\" loading=\"lazy\" data-kid=\"129\">\n            <img class=\"inline-block h-8 w-8 rounded-full ring-4 ring-white\" src=\"https://i.pravatar.cc/100?u=3\" alt decoding=\"async\" loading=\"lazy\" data-kid=\"130\">\n            <div class=\"flex items-center justify-center h-8 w-8 rounded-full bg-[#0070BB] text-[10px] text-white font-bold ring-4 ring-white\" data-kid=\"131\">+24</div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-2 row-span-1 glass-card p-8 flex flex-col\" data-kid=\"132\">\n        <div class=\"flex justify-between items-center mb-8\" data-kid=\"133\">\n            <h4 class=\"font-heading font-extrabold text-sm uppercase tracking-wider text-[#004953]\" data-kid=\"134\">Active Shipment: #TRK-88210</h4>\n            <div class=\"flex gap-2\" data-kid=\"135\">\n                <button class=\"p-2 bg-white rounded-lg border border-black/[0.05] hover:shadow-md transition-shadow\" data-kid=\"136\">\n                    <i class=\"ti ti-chevron-left text-xs text-[#004953]\" data-kid=\"137\"></i>\n                </button>\n                <button class=\"p-2 bg-white rounded-lg border border-black/[0.05] hover:shadow-md transition-shadow\" data-kid=\"138\">\n                    <i class=\"ti ti-chevron-right text-xs text-[#004953]\" data-kid=\"139\"></i>\n                </button>\n            </div>\n        </div>\n\n        <div class=\"relative flex-1 flex items-start justify-between px-10 pt-4\" data-kid=\"140\">\n          \n          <div class=\"absolute top-[32px] left-10 right-10 h-0.5 bg-[#004953]/10\" data-kid=\"141\"></div>\n          \n          \n          <div class=\"relative z-10 flex flex-col items-center group\" data-kid=\"142\">\n            <div class=\"w-8 h-8 rounded-full bg-[#004953] flex items-center justify-center shadow-lg shadow-[#004953]/20 mb-3 group-hover:scale-110 transition-transform cursor-pointer relative\" data-kid=\"143\">\n              <i class=\"ti ti-check text-white text-sm\" data-kid=\"144\"></i>\n              <div class=\"absolute inset-0 rounded-full animate-ping bg-[#004953]/10 group-hover:opacity-100 opacity-0 transition-opacity\" data-kid=\"145\"></div>\n            </div>\n            <p class=\"text-[10px] font-extrabold text-[#004953] uppercase tracking-tighter\" data-kid=\"146\">Dispatched</p>\n            <p class=\"text-[9px] text-[#004953]/40 font-bold\" data-kid=\"147\">Shanghai Port</p>\n          </div>\n\n          <div class=\"relative z-10 flex flex-col items-center group\" data-kid=\"148\">\n            <div class=\"w-8 h-8 rounded-full bg-[#004953] flex items-center justify-center shadow-lg shadow-[#004953]/20 mb-3 group-hover:scale-110 transition-transform cursor-pointer\" data-kid=\"149\">\n              <i class=\"ti ti-check text-white text-sm\" data-kid=\"150\"></i>\n            </div>\n            <p class=\"text-[10px] font-extrabold text-[#004953] uppercase tracking-tighter\" data-kid=\"151\">Overseas</p>\n            <p class=\"text-[9px] text-[#004953]/40 font-bold\" data-kid=\"152\">In Transit</p>\n          </div>\n\n          <div class=\"relative z-10 flex flex-col items-center group\" data-kid=\"153\">\n            <div class=\"w-10 h-10 rounded-full bg-[#0070BB] flex items-center justify-center shadow-[0_0_20px_rgba(0,112,187,0.4)] mb-3 ring-4 ring-[#0070BB]/20 group-hover:scale-110 transition-transform cursor-pointer\" data-kid=\"154\">\n              <i class=\"ti ti-ship text-white text-lg\" data-kid=\"155\"></i>\n            </div>\n            <p class=\"text-[10px] font-extrabold text-[#0070BB] uppercase tracking-tighter drop-shadow-sm\" data-kid=\"156\">Current</p>\n            <p class=\"text-[9px] text-[#0070BB]/60 font-bold\" data-kid=\"157\">Gulf of Aden</p>\n          </div>\n\n          <div class=\"relative z-10 flex flex-col items-center opacity-40 group grayscale hover:grayscale-0 hover:opacity-100 transition-all\" data-kid=\"158\">\n            <div class=\"w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform cursor-pointer\" data-kid=\"159\">\n              <i class=\"ti ti-package text-gray-400 text-sm\" data-kid=\"160\"></i>\n            </div>\n            <p class=\"text-[10px] font-extrabold text-gray-500 uppercase tracking-tighter\" data-kid=\"161\">Unloading</p>\n            <p class=\"text-[9px] text-gray-400 font-bold\" data-kid=\"162\">Port of Suez</p>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-2 row-span-1 glass-card p-6 flex flex-col\" data-kid=\"163\">\n        <div class=\"flex justify-between items-center mb-4\" data-kid=\"164\">\n            <h4 class=\"font-heading font-extrabold text-sm uppercase tracking-wider text-[#004953]\" data-kid=\"165\">Intelligence Stream</h4>\n            <span class=\"text-[10px] font-bold text-[#0070BB] cursor-pointer hover:underline uppercase tracking-widest\" data-kid=\"166\">Analyze All</span>\n        </div>\n\n        <div class=\"space-y-3 flex-1 overflow-hidden\" data-kid=\"167\">\n          \n          <div class=\"flex items-start gap-4 p-4 bg-white/40 rounded-2xl border-l-4 border-[#0070BB] shadow-sm group hover:bg-white transition-all cursor-pointer\" data-kid=\"168\">\n            <div class=\"w-10 h-10 bg-[#0070BB]/10 rounded-xl shrink-0 flex items-center justify-center text-[#0070BB]\" data-kid=\"169\">\n              <i class=\"ti ti-cloud-storm text-lg\" data-kid=\"170\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"171\">\n              <div class=\"flex justify-between mb-1\" data-kid=\"172\">\n                <p class=\"text-xs font-extrabold text-[#004953]\" data-kid=\"173\">Weather Anomaly</p>\n                <span class=\"text-[9px] text-[#004953]/40 font-bold\" data-kid=\"174\">2m ago</span>\n              </div>\n              <p class=\"text-[11px] text-[#004953]/70 font-medium leading-relaxed\" data-kid=\"175\">System suggests rerouting Fleet B-9 via Cape Route to avoid cyclonic conditions.</p>\n            </div>\n          </div>\n\n          \n          <div class=\"flex items-start gap-4 p-4 bg-white/40 rounded-2xl border-l-4 border-[#004953] shadow-sm group hover:bg-white transition-all cursor-pointer\" data-kid=\"176\">\n            <div class=\"w-10 h-10 bg-[#004953]/10 rounded-xl shrink-0 flex items-center justify-center text-[#004953]\" data-kid=\"177\">\n              <i class=\"ti ti-anchor text-lg\" data-kid=\"178\"></i>\n            </div>\n            <div class=\"flex-1\" data-kid=\"179\">\n              <div class=\"flex justify-between mb-1\" data-kid=\"180\">\n                <p class=\"text-xs font-extrabold text-[#004953]\" data-kid=\"181\">Port Congestion</p>\n                <span class=\"text-[9px] text-[#004953]/40 font-bold\" data-kid=\"182\">15m ago</span>\n              </div>\n              <p class=\"text-[11px] text-[#004953]/70 font-medium leading-relaxed\" data-kid=\"183\">Berth availability at Port Rotterdam decreased to 12%. Schedule adjustments recommended.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </main>\n</div>\n",
