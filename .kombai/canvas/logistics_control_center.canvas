e\" data-kid=\"187\">Synced 100%</p>\n          </div>\n        </div>\n        <div class=\"w-12 h-6 border-[3px] border-[var(--prussian-blue)] p-1 flex items-center bg-[var(--deep-sky-blue)] shadow-brutal-sm\" data-kid=\"188\">\n          <div class=\"ml-auto w-4 h-full bg-white border-[2px] border-[var(--prussian-blue)]\" data-kid=\"189\"></div>\n        </div>\n      </div>\n\n      \n      <div class=\"brutalist-card p-4 flex items-center justify-between bg-[var(--sand-dune)] hover:bg-[var(--sand-dune)]/80 transition-colors cursor-pointer group\" data-kid=\"190\">\n        <div class=\"flex items-center gap-4 opacity-50\" data-kid=\"191\">\n          <div class=\"w-10 h-10 bg-[var(--prussian-blue)] text-white flex items-center justify-center\" data-kid=\"192\">\n             <i class=\"ti ti-satellite text-xl\" data-kid=\"193\"></i>\n          </div>\n          <div data-kid=\"194\">\n            <p class=\"text-[9px] font-black text-[var(--prussian-blue)]/40 leading-none mb-1 uppercase\" data-kid=\"195\">Sat-Com (B)</p>\n            <p class=\"text-xs font-black uppercase\" data-kid=\"196\">Standby</p>\n          </div>\n        </div>\n        <div class=\"w-12 h-6 border-[3px] border-[var(--prussian-blue)] p-1 flex items-center bg-[var(--prussian-blue)]/20 shadow-brutal-sm\" data-kid=\"197\">\n          <div class=\"w-4 h-full bg-white border-[2px] border-[var(--prussian-blue)]\" data-kid=\"198\"></div>\n        </div>\n      </div>\n\n      \n      <div class=\"brutalist-card p-4 flex items-center justify-between hover:bg-[var(--deep-sky-blue)]/5 transition-colors cursor-pointer group\" data-kid=\"199\">\n        <div class=\"flex items-center gap-4\" data-kid=\"200\">\n          <div class=\"w-10 h-10 bg-[var(--prussian-blue)] text-white flex items-center justify-center\" data-kid=\"201\">\n             <i class=\"ti ti-device-heart-monitor text-xl\" data-kid=\"202\"></i>\n          </div>\n          <div data-kid=\"203\">\n            <p class=\"text-[9px] font-black text-[var(--prussian-blue)]/40 leading-none mb-1 uppercase\" data-kid=\"204\">Fleet GPS API</p>\n            <p class=\"text-xs font-black uppercase\" data-kid=\"205\">Operational</p>\n          </div>\n        </div>\n        <div class=\"w-12 h-6 border-[3px] border-[var(--prussian-blue)] p-1 flex items-center bg-[var(--deep-sky-blue)] shadow-brutal-sm\" data-kid=\"206\">\n          <div class=\"ml-auto w-4 h-full bg-white border-[2px] border-[var(--prussian-blue)]\" data-kid=\"207\"></div>\n        </div>\n      </div>\n\n      \n      <div class=\"brutalist-card p-4 flex items-center justify-between hover:bg-[var(--deep-sky-blue)]/5 transition-colors cursor-pointer group\" data-kid=\"208\">\n        <div class=\"flex items-center gap-4\" data-kid=\"209\">\n          <div class=\"w-10 h-10 bg-[var(--prussian-blue)] text-white flex items-center justify-center\" data-kid=\"210\">\n             <i class=\"ti ti-cpu text-xl\" data-kid=\"211\"></i>\n          </div>\n          <div data-kid=\"212\">\n            <p class=\"text-[9px] font-black text-[var(--prussian-blue)]/40 leading-none mb-1 uppercase\" data-kid=\"213\">AI Predictor</p>\n            <p class=\"text-xs font-black uppercase\" data-kid=\"214\">Autopilot ON</p>\n          </div>\n        </div>\n        <div class=\"w-12 h-6 border-[3px] border-[var(--prussian-blue)] p-1 flex items-center bg-[var(--deep-sky-blue)] shadow-brutal-sm\" data-kid=\"215\">\n          <div class=\"ml-auto w-4 h-full bg-white border-[2px] border-[var(--prussian-blue)]\" data-kid=\"216\"></div>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n</div>\n",
