pan>\n            <span data-kid=\"108\">12:00</span>\n            <span data-kid=\"109\">16:00</span>\n            <span data-kid=\"110\">20:00</span>\n            <span data-kid=\"111\">00:00</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"backlog-section\" class=\"pt-8\" data-kid=\"112\">\n      <div class=\"flex items-center gap-6 mb-8\" data-kid=\"113\">\n        <h2 class=\"font-['Syne'] text-4xl font-black uppercase tracking-tighter\" data-kid=\"114\">Incident_Backlog</h2>\n        <div class=\"h-1 flex-grow bg-[#222]\" data-kid=\"115\"></div>\n        <div class=\"flex items-center gap-4\" data-kid=\"116\">\n          <div class=\"text-[10px] font-black border-4 border-[#222] px-4 py-2 bg-white flex items-center gap-3\" data-kid=\"117\">\n            QUEUE_LOAD: <span id=\"queue-count\" class=\"text-xl\" data-kid=\"118\">03</span>\n          </div>\n          <button id=\"add-incident-btn\" class=\"bg-[#222] text-white px-6 py-3 text-xs font-black uppercase hover:bg-[#4285F4] transition-colors cursor-pointer active:translate-y-1\" data-kid=\"119\">\n            + SIM_INCIDENT\n          </button>\n        </div>\n      </div>\n\n      <div id=\"backlog-list\" class=\"space-y-6\" data-kid=\"120\">\n        \n        <div class=\"incident-item bg-white border-4 border-[#222] flex items-stretch min-h-[100px] shadow-[8px_8px_0_rgba(34,34,34,1)] group\" data-id=\"1\" data-kid=\"121\">\n          <div class=\"w-4 bg-[#EA4335]\" data-kid=\"122\"></div>\n          <div class=\"flex-grow p-6 flex flex-col justify-between\" data-kid=\"123\">\n            <div class=\"flex justify-between items-start\" data-kid=\"124\">\n              <span class=\"text-xs font-black text-[#EA4335] uppercase tracking-widest flex items-center gap-2\" data-kid=\"125\">\n                <i class=\"ti ti-radio animate-pulse\" data-kid=\"126\"></i> CRITICAL_SYS_FAILURE_09\n              </span>\n              <span class=\"text-[10px] font-bold opacity-40\" data-kid=\"127\">T+ 00:18:44</span>\n            </div>\n            <div class=\"mt-4 flex items-center gap-4\" data-kid=\"128\">\n              <span class=\"text-lg font-bold uppercase tracking-tight\" data-kid=\"129\">Mainframe_Heat_Threshold_Exceeded | Server_Room_B</span>\n            </div>\n          </div>\n          <div class=\"border-l-4 border-[#222] px-8 flex items-center gap-6 bg-[#F9F9F9]\" data-kid=\"130\">\n            <div class=\"flex -space-x-4\" data-kid=\"131\">\n              <img src=\"https://i.pravatar.cc/48?u=alex\" class=\"w-12 h-12 border-4 border-[#222] rounded-none grayscale\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"132\">\n              <img src=\"https://i.pravatar.cc/48?u=sarah\" class=\"w-12 h-12 border-4 border-[#222] rounded-none grayscale\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"133\">\n            </div>\n            <button class=\"resolve-btn bg-[#222] text-white px-8 py-3 text-xs font-black uppercase hover:bg-[#EA4335] cursor-pointer\" data-kid=\"134\">\n              DISPATCH\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"incident-item bg-white border-4 border-[#222] flex items-stretch min-h-[100px] shadow-[8px_8px_0_rgba(34,34,34,1)] group\" data-id=\"2\" data-kid=\"135\">\n          <div class=\"w-4 bg-[#FBBC05]\" data-kid=\"136\"></div>\n          <div class=\"flex-grow p-6 flex flex-col justify-between\" data-kid=\"137\">\n            <div class=\"flex justify-between items-start\" data-kid=\"138\">\n              <span class=\"text-xs font-black text-[#FBBC05] uppercase tracking-widest flex items-center gap-2\" data-kid=\"139\">\n                <i class=\"ti ti-broadcast\" data-kid=\"140\"></i> WARNING_LATENCY_SPIKE\n              </span>\n              <span class=\"text-[10px] font-bold opacity-40\" data-kid=\"141\">T+ 00:08:12</span>\n            </div>\n            <div class=\"mt-4 flex items-center gap-4\" data-kid=\"142\">\n              <span class=\"text-lg font-bold uppercase tracking-tight\" data-kid=\"143\">Satellite_Handover_Delay | Oceanic_Sector_4</span>\n            </div>\n          </div>\n          <div class=\"border-l-4 border-[#222] px-8 flex items-center gap-6 bg-[#F9F9F9]\" data-kid=\"144\">\n            <div class=\"flex -space-x-4\" data-kid=\"145\">\n              <img src=\"https://i.pravatar.cc/48?u=mike\" class=\"w-12 h-12 border-4 border-[#222] rounded-none grayscale\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"146\">\n            </div>\n            <button class=\"resolve-btn bg-[#222] text-white px-8 py-3 text-xs font-black uppercase hover:bg-[#FBBC05] hover:text-[#222] cursor-pointer\" data-kid=\"147\">\n              REROUTE\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"incident-item bg-white border-4 border-[#222] flex items-stretch min-h-[100px] shadow-[8px_8px_0_rgba(34,34,34,1)] group\" data-id=\"3\" data-kid=\"148\">\n          <div class=\"w-4 bg-[#4285F4]\" data-kid=\"149\"></div>\n          <div class=\"flex-grow p-6 flex flex-col justify-between\" data-kid=\"150\">\n            <div class=\"flex justify-between items-start\" data-kid=\"151\">\n              <span class=\"text-xs font-black text-[#4285F4] uppercase tracking-widest flex items-center gap-2\" data-kid=\"152\">\n                <i class=\"ti ti-microphone\" data-kid=\"153\"></i> COMMS_ROUTINE_CHECK\n              </span>\n              <span class=\"text-[10px] font-bold opacity-40\" data-kid=\"154\">T+ 00:02:55</span>\n            </div>\n            <div class=\"mt-4 flex items-center gap-4\" data-kid=\"155\">\n              <span class=\"text-lg font-bold uppercase tracking-tight\" data-kid=\"156\">Driver_332_Voice_Authentication | Waypoint_Red_Zero</span>\n            </div>\n          </div>\n          <div class=\"border-l-4 border-[#222] px-8 flex items-center gap-6 bg-[#F9F9F9]\" data-kid=\"157\">\n            <div class=\"flex -space-x-4\" data-kid=\"158\">\n              <img src=\"https://i.pravatar.cc/48?u=jane\" class=\"w-12 h-12 border-4 border-[#222] rounded-none grayscale\" alt=\"User\" decoding=\"async\" loading=\"lazy\" data-kid=\"159\">\n            </div>\n            <button class=\"resolve-btn bg-[#222] text-white px-8 py-3 text-xs font-black uppercase hover:bg-[#4285F4] cursor-pointer\" data-kid=\"160\">\n              ACKNOWLEDGE\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"pt-12 border-t-4 border-[#222] flex flex-col md:flex-row justify-between gap-8 pb-8\" data-kid=\"161\">\n      <div class=\"flex flex-col gap-2\" data-kid=\"162\">\n        <div class=\"font-['Syne'] font-black text-xl italic uppercase\" data-kid=\"163\">Operational_Integrity_Confirmed</div>\n        <div class=\"text-[9px] font-bold opacity-50 uppercase tracking-[0.3em]\" data-kid=\"164\">Last_System_Sync: 2024-05-12 // 14:22:09 // KONSTRUKT_V.4.2</div>\n      </div>\n      <div class=\"flex gap-8 items-center text-[10px] font-black uppercase tracking-widest\" data-kid=\"165\">\n        <a href=\"#\" class=\"hover:underline\" data-kid=\"166\">Documentation</a>\n        <a href=\"#\" class=\"hover:underline\" data-kid=\"167\">Security_Policy</a>\n        <a href=\"#\" class=\"hover:underline\" data-kid=\"168\">Operator_Manual</a>\n        <div class=\"px-4 py-2 border-2 border-[#222] bg-white\" data-kid=\"169\">\n          AUTH_LEVEL: L_09\n        </div>\n      </div>\n    </footer>\n  </main>\n\n  <style data-kid=\"170\">\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar {\n      width: 12px;\n    }\n    ::-webkit-scrollbar-track {\n      background: #F0F0F0;\n      border-left: 4px border #222;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: #222;\n      border: 4px solid #F0F0F0;\n    }\n\n\n    @keyframes scan {\n      0% { transform: translateY(-100%); }\n      100% { transform: translateY(100%); }\n    }\n\n    .scanning-line {\n      animation: scan 10s linear infinite;\n    }\n  </style>\n\n  \n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"171\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"172\"></script>\n  <script type=\"module\" data-kid=\"173\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initial Staggered Entrance for Bento Cards\n    gsap.set('.bento-card', { opacity: 0, y: 30 });\n    \n    ScrollTrigger.batch('.bento-card', {\n      onEnter: (elements) => {\n        gsap.to(elements, {\n          opacity: 1,\n          y: 0,\n          duration: 0.6,\n          stagger: 0.1,\n          ease: \"expo.out\",\n          overwrite: true\n        });\n      },\n      start: \"top 95%\",\n      once: true\n    });\n\n    // Clock update\n    function updateClock() {\n      const now = new Date();\n      const h = String(now.getHours()).padStart(2, '0');\n      const m = String(now.getMinutes()).padStart(2, '0');\n      const s = String(now.getSeconds()).padStart(2, '0');\n      const clockEl = document.getElementById('clock');\n      if (clockEl) clockEl.textContent = `${h}:${m}:${s} UTC`;\n    }\n    setInterval(updateClock, 1000);\n    updateClock();\n\n    // Incident List Logic\n    const backlogList = document.getElementById('backlog-list');\n    const addBtn = document.getElementById('add-incident-btn');\n    const queueCount = document.getElementById('queue-count');\n\n    function updateQueueCount() {\n      const items = backlogList.querySelectorAll('.incident-item').length;\n      queueCount.textContent = String(items).padStart(2, '0');\n    }\n\n    // Resolve Incident Animation (Anime.js)\n    backlogList.addEventListener('click', (e) => {\n      if (e.target.classList.contains('resolve-btn')) {\n        const item = e.target.closest('.incident-item');\n        \n        animate({\n          targets: item,\n          opacity: 0,\n          translateX: 100,\n          height: 0,\n          marginTop: 0,\n          marginBottom: 0,\n          paddingTop: 0,\n          paddingBottom: 0,\n          duration: 500,\n          easing: 'easeInBack',\n          complete: () => {\n            item.remove();\n            updateQueueCount();\n          }\n        });\n      }\n    });\n\n    // Add Incident Animation (Anime.js)\n    addBtn.addEventListener('click', () => {\n      const id = Date.now();\n      const types = [\n        { label: 'CRITICAL_FUEL_LEAK', color: '#EA4335', icon: 'ti-radio', text: 'Hazmat_Spill_Detected | Sector_F12' },\n        { label: 'WARNING_GRID_DROP', color: '#FBBC05', icon: 'ti-broadcast', text: 'Regional_Power_Instability | Hub_Central' },\n        { label: 'INFO_LOG_REQUEST', color: '#4285F4', icon: 'ti-microphone', text: 'Terminal_Handshake_Required | Port_99' }\n      ];\n      const type = types[Math.floor(Math.random() * types.length)];\n      \n      const newItem = document.createElement('div');\n      newItem.className = 'incident-item bg-white border-4 border-[#222] flex items-stretch min-h-[100px] shadow-[8px_8px_0_rgba(34,34,34,1)] opacity-0';\n      newItem.dataset.id = id;\n      newItem.innerHTML = `\n        <div class=\"w-4\" style=\"background-color: ${type.color}\"></div>\n        <div class=\"flex-grow p-6 flex flex-col justify-between\">\n          <div class=\"flex justify-between items-start\">\n            <span class=\"text-xs font-black uppercase tracking-widest flex items-center gap-2\" style=\"color: ${type.color}\">\n              <i class=\"ti ${type.icon} ${type.color === '#EA4335' ? 'animate-pulse' : ''}\"></i> ${type.label}\n            </span>\n            <span class=\"text-[10px] font-bold opacity-40\">T+ 00:00:01</span>\n          </div>\n          <div class=\"mt-4 flex items-center gap-4\">\n            <span class=\"text-lg font-bold uppercase tracking-tight\">${type.text}</span>\n          </div>\n        </div>\n        <div class=\"border-l-4 border-[#222] px-8 flex items-center gap-6 bg-[#F9F9F9]\">\n          <div class=\"flex -space-x-4\">\n            <img src=\"https://i.pravatar.cc/48?u=${id}\" class=\"w-12 h-12 border-4 border-[#222] rounded-none grayscale\" alt=\"User\">\n          </div>\n          <button class=\"resolve-btn bg-[#222] text-white px-8 py-3 text-xs font-black uppercase hover:opacity-80 cursor-pointer\">\n            PROCESS\n          </button>\n        </div>\n      `;\n      \n      backlogList.prepend(newItem);\n      \n      animate({\n        targets: newItem,\n        opacity: [0, 1],\n        translateY: [-20, 0],\n        duration: 600,\n        easing: 'easeOutElastic(1, .6)'\n      });\n      \n      updateQueueCount();\n    });\n\n  </script>\n</div>\n",
