      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;700;900&family=Hind:wght@400;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css');\n\n  :root {\n    --porcelain: #FEFEFA;\n    --sand-dune: #EAE0C8;\n    --prussian-blue: #002147;\n    --deep-sky-blue: #00BFFF;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--porcelain);\n    font-family: 'Hind', sans-serif;\n    color: var(--prussian-blue);\n  }\n\n  .font-heading { font-family: 'Encode Sans', sans-serif; }\n  \n  .brutalist-card {\n    border: 3px solid var(--prussian-blue);\n    box-shadow: 6px 6px 0 0 var(--prussian-blue);\n    background: white;\n    border-radius: 0;\n  }\n\n  .hard-offset {\n    box-shadow: 10px 10px 0 0 var(--prussian-blue);\n  }\n\n  @keyframes pulse-ring {\n    0% { transform: scale(0.33); }\n    80%, 100% { opacity: 0; }\n  }\n\n  @keyframes pulse-dot {\n    0% { transform: scale(0.8); }\n    50% { transform: scale(1.1); }\n    100% { transform: scale(0.8); }\n  }\n\n  .pulse-container {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .pulse-ring {\n    position: absolute;\n    width: 48px;\n    height: 48px;\n    background-color: var(--deep-sky-blue);\n    border-radius: 50%;\n    animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;\n  }\n\n  .pulse-dot {\n    position: relative;\n    width: 14px;\n    height: 14px;\n    background-color: var(--deep-sky-blue);\n    border-radius: 50%;\n    border: 2px solid var(--prussian-blue);\n    animation: pulse-dot 2s cubic-bezier(0.455, 0.03, 0.515, 0.955) infinite;\n    z-index: 10;\n  }\n\n  .map-grid {\n    background-image: \n      linear-gradient(to right, rgba(0, 33, 71, 0.08) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(0, 33, 71, 0.08) 1px, transparent 1px);\n    background-size: 50px 50px;\n    background-color: #f0f2f5;\n  }\n\n  .nav-tab-active {\n    border-bottom: 6px solid var(--deep-sky-blue);\n    color: var(--prussian-blue);\n    font-weight: 900;\n    margin-bottom: -4px;\n    z-index: 10;\n    background: rgba(0, 191, 255, 0.05);\n  }\n\n  .toggle-switch-on {\n    background-color: var(--deep-sky-blue);\n  }\n  \n  .toggle-switch-off {\n    background-color: var(--prussian-blue);\n    opacity: 0.2;\n  }\n\n  .shadow-brutal-sm {\n    box-shadow: 3px 3px 0 0 var(--prussian-blue);\n  }\n</style>\n\n<div class=\"w-full max-w-[1440px] mx-auto bg-[var(--porcelain)] p-6 flex flex-col gap-6 min-h-[950px]\" data-kid=\"1\">\n  \n  \n  <header class=\"flex items-center justify-between border-b-[4px] border-[var(--prussian-blue)] relative\" data-kid=\"2\">\n    <div class=\"flex items-stretch h-16 relative\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3 px-6 bg-[var(--prussian-blue)] text-white mr-8 shadow-[0_0_20px_rgba(0,191,255,0.2)]\" data-kid=\"4\">\n        <i class=\"ti ti-broadcast text-2xl text-[var(--deep-sky-blue)] drop-shadow-[0_0_8px_rgba(0,191,255,0.5)]\" data-kid=\"5\"></i>\n        <span class=\"font-heading font-black text-2xl tracking-tighter uppercase italic\" data-kid=\"6\">Control Hub</span>\n      </div>\n      <button class=\"px-8 flex items-center nav-tab-active font-heading text-sm uppercase tracking-widest cursor-pointer\" data-kid=\"7\">Live Hub</button>\n      <button class=\"px-8 flex items-center font-heading text-sm uppercase tracking-widest text-[var(--prussian-blue)]/50 hover:bg-[var(--sand-dune)] transition-all cursor-pointer\" data-kid=\"8\">Fleet Manager</button>\n      <button class=\"px-8 flex items-center font-heading text-sm uppercase tracking-widest text-[var(--prussian-blue)]/50 hover:bg-[var(--sand-dune)] transition-all cursor-pointer\" data-kid=\"9\">Analytics Matrix</button>\n      <button class=\"px-8 flex items-center font-heading text-sm uppercase tracking-widest text-[var(--