      "html": "\n<main class=\"relative w-screen h-screen bg-[#E8EAED] overflow-hidden\" data-kid=\"0\">\n    \n    \n    <div id=\"map-location-view\" class=\"absolute inset-0\" data-kid=\"1\">\n        <svg class=\"map-svg\" viewBox=\"0 0 1440 900\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"2\">\n            <defs data-kid=\"3\">\n                <pattern id=\"grid\" width=\"60\" height=\"60\" patternUnits=\"userSpaceOnUse\" data-kid=\"4\">\n                    <path d=\"M 60 0 L 0 0 0 60\" fill=\"none\" stroke=\"rgba(0,0,0,0.03)\" stroke-width=\"1\" data-kid=\"5\"></path>\n                </pattern>\n            </defs>\n            <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" data-kid=\"6\"></rect>\n            \n            <path d=\"M150,250 c50,-50 150,-20 200,30 s100,100 200,50 s150,-80 250,-20 s100,100 200,150 s150,20 200,-50\" fill=\"none\" stroke=\"rgba(0,0,0,0.03)\" stroke-width=\"180\" stroke-linecap=\"round\" data-kid=\"7\"></path>\n            <path d=\"M100,650 c80,20 180,-30 250,-80 s120,-100 220,-50 s180,120 300,80 s150,-40 220,-100 s100,-20 180,30\" fill=\"none\" stroke=\"rgba(0,0,0,0.03)\" stroke-width=\"140\" stroke-linecap=\"round\" data-kid=\"8\"></path>\n\n            <g id=\"shipping-routes\" data-kid=\"9\">\n                <path id=\"route1\" class=\"route-path\" d=\"M1200,600 Q1000,400 800,500 T400,300\" data-kid=\"10\"></path>\n                <path id=\"route2\" class=\"route-path\" d=\"M200,400 Q400,500 600,700 T900,600\" data-kid=\"11\"></path>\n                <path id=\"route3\" class=\"route-path\" d=\"M500,200 Q550,300 600,250 T700,400\" data-kid=\"12\"></path>\n            </g>\n\n            <g id=\"markers\" data-kid=\"13\">\n                <circle cx=\"400\" cy=\"300\" r=\"6\" fill=\"var(--google-blue)\" data-kid=\"14\"></circle>\n                <circle cx=\"400\" cy=\"300\" r=\"12\" fill=\"var(--google-blue)\" class=\"marker-pulse\" data-kid=\"15\"></circle>\n                <circle cx=\"1200\" cy=\"600\" r=\"6\" fill=\"var(--google-green)\" data-kid=\"16\"></circle>\n                <circle cx=\"900\" cy=\"600\" r=\"6\" fill=\"var(--google-red)\" data-kid=\"17\"></circle>\n                <circle cx=\"200\" cy=\"400\" r=\"6\" fill=\"var(--google-yellow)\" data-kid=\"18\"></circle>\n            </g>\n        </svg>\n    </div>\n\n    \n    <aside id=\"floating-drawer\" class=\"absolute top-6 left-6 bottom-6 w-96 bg-white rounded-[28px] shadow-[0_24px_48px_-12px_rgba(0,0,0,0.15)] z-50 flex flex-col p-8 border border-white\" data-kid=\"19\">\n        <div class=\"flex items-center gap-3 mb-8\" data-kid=\"20\">\n            <div class=\"w-10 h-10 bg-white rounded-xl shadow-md flex items-center justify-center border border-gray-100\" data-kid=\"21\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" data-kid=\"22\">\n                    <path d=\"M12 2L2 7L12 12L22 7L12 2Z\" fill=\"var(--google-blue)\" data-kid=\"23\"></path>\n                    <path d=\"M2 17L12 22L22 17\" stroke=\"var(--google-blue)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"24\"></path>\n                    <path d=\"M2 12L12 17L22 12\" stroke=\"var(--google-blue)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"25\"></path>\n                </svg>\n            </div>\n            <div data-kid=\"26\">\n                <h1 class=\"font-outfit text-xl font-bold text-gray-900 leading-none\" data-kid=\"27\">Global Control</h1>\n                <p class=\"text-[11px] text-gray-500 font-medium tracking-wider uppercase mt-1\" data-kid=\"28\">Logistics Command Center</p>\n            </div>\n            <button class=\"ml-auto w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400\" data-kid=\"29\">\n                <i data-lucide=\"more-vertical\" class=\"w-5 h-5\" data-kid=\"30\"></i>\n            </button>\n        </div>\n\n        <div id=\"centered-search\" class=\"relative mb-8\" data-kid=\"31\">\n            <div class=\"absolute inset-y-0 left-4 flex items-center pointer-events-none\" data-kid=\"32\">\n                <i data-lucide=\"search\" class=\"w-5 h-5 text-gray-400\" data-kid=\"33\"></i>\n            </div>\n            <input type=\"text\" placeholder=\"Search vehicle, ID, or route...\" class=\"w-full bg-gray-100 border-none rounded-2xl py-4 pl-12 pr-14 text-sm font-medium focus:ring-2 focus:ring-[var(--google-blue)] transition-all outline-none text-gray-700\" data-kid=\"34\">\n            <div class=\"absolute right-2 top-1/2 -translate-y-1/2\" data-kid=\"35\">\n                <button class=\"bg-white p-2 rounded-xl shadow-sm border border-gray-200 hover:bg-gray-50 text-gray-600 transition-colors\" data-kid=\"36\">\n                    <i data-lucide=\"sliders-horizontal\" class=\"w-4 h-4\" data-kid=\"37\"></i>\n                </button>\n            </div>\n        </div>\n\n        <div class=\"flex-1 overflow-y-auto drawer-scroll -mr-2 pr-2\" data-kid=\"38\">\n            <h3 class=\"font-outfit text-xs font-bold text-gray-400 uppercase tracking-[0.2em] mb-4\" data-kid=\"39\">Real-Time Fleet</h3>\n            <div id=\"card-rows\" class=\"space-y-4\" data-kid=\"40\">\n                <div class=\"group p-5 bg-gray-50/50 hover:bg-white border border-transparent hover:border-blue-100 rounded-[22px] transition-all cursor-pointer shadow-sm hover:shadow-lg\" data-kid=\"41\">\n                    <div class=\"flex items-start gap-4\" data-kid=\"42\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-[var(--google-blue)] shrink-0 group-hover:scale-110\" data-kid=\"43\">\n                            <i data-lucide=\"truck\" class=\"w-6 h-6\" data-kid=\"44\"></i>\n                        </div>\n                        <div class=\"flex-1 min-w-0\" data-kid=\"45\">\n                            <div class=\"flex justify-between items-start mb-1\" data-kid=\"46\">\n                                <span class=\"font-outfit font-bold text-gray-900\" data-kid=\"47\">VOLVO-FX72</span>\n                                <span class=\"text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-bold\" data-kid=\"48\">ON TIME</span>\n                            </div>\n                            <p class=\"text-xs text-gray-500 mb-3 flex items-center gap-1\" data-kid=\"49\">\n                                <i data-lucide=\"map-pin\" class=\"w-3 h-3\" data-kid=\"50\"></i> 4.2km from Hub A\n                            </p>\n                            <div class=\"flex items-center gap-4\" data-kid=\"51\">\n                                <div class=\"flex flex-col\" data-kid=\"52\"><span class=\"text-[10px] text-gray-400 font-bold uppercase\" data-kid=\"53\">Speed</span><span class=\"text-xs font-bold text-gray-700\" data-kid=\"54\">82 km/h</span></div>\n                                <div class=\"flex flex-col\" data-kid=\"55\"><span class=\"text-[10px] text-gray-400 font-bold uppercase\" data-kid=\"56\">Battery</span><span class=\"text-xs font-bold text-gray-700\" data-kid=\"57\">64%</span></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"group p-5 bg-gray-50/50 hover:bg-white border border-transparent hover:border-blue-100 rounded-[22px] transition-all cursor-pointer shadow-sm hover:shadow-lg\" data-kid=\"58\">\n                    <div class=\"flex items-start gap-4\" data-kid=\"59\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-500 shrink-0 group-hover:scale-110\" data-kid=\"60\">\n                            <i data-lucide=\"package\" class=\"w-6 h-6\" data-kid=\"61\"></i>\n                        </div>\n                        <div class=\"flex-1 min-w-0\" data-kid=\"62\">\n                            <div class=\"flex justify-between items-start mb-1\" data-kid=\"63\">\n                                <span class=\"font-outfit font-bold text-gray-900\" data-kid=\"64\">DHL-EXP-44</span>\n                                <span class=\"text-[10px] px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 font-bold\" data-kid=\"65\">DELAYED</span>\n                            </div>\n                            <p class=\"text-xs text-gray-500 mb-3 flex items-center gap-1\" data-kid=\"66\">\n                                <i data-lucide=\"clock\" class=\"w-3 h-3\" data-kid=\"67\"></i> Arriving in 42m\n                            </p>\n                            <div class=\"flex items-center gap-4\" data-kid=\"68\">\n                                <div class=\"flex flex-col\" data-kid=\"69\"><span class=\"text-[10px] text-gray-400 font-bold uppercase\" data-kid=\"70\">Temp</span><span class=\"text-xs font-bold text-gray-700\" data-kid=\"71\">-18°C</span></div>\n                                <div class=\"flex flex-col\" data-kid=\"72\"><span class=\"text-[10px] text-gray-400 font-bold uppercase\" data-kid=\"73\">Load</span><span class=\"text-xs font-bold text-gray-700\" data-kid=\"74\">880 kg</span></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mt-8 pt-6 border-t border-gray-100 flex gap-3\" data-kid=\"75\">\n            <button class=\"flex-1 bg-gray-900 text-white font-outfit font-semibold py-3.5 rounded-2xl hover:bg-gray-800 transition-colors flex items-center justify-center gap-2 text-sm shadow-xl\" data-kid=\"76\">\n                <i data-lucide=\"plus\" class=\"w-4 h-4\" data-kid=\"77\"></i> New Dispatch\n            </button>\n            <button class=\"w-14 bg-gray-100 text-gray-600 rounded-2xl hover:bg-gray-200 transition-colors flex items-center justify-center\" data-kid=\"78\">\n                <i data-lucide=\"bell\" class=\"w-5 h-5\" data-kid=\"79\"></i>\n            </button>\n        </div>\n    </aside>\n\n    \n    <div id=\"kpi-container\" class=\"absolute top-8 right-8 flex gap-4 z-50\" data-kid=\"80\">\n        <div class=\"kpi-card-anim glass-kpi w-44 p-5 rounded-[24px] shadow-2xl\" data-kid=\"81\">\n            <div class=\"flex justify-between items-start mb-3\" data-kid=\"82\">\n                <div class=\"w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-[var(--google-blue)]\" data-kid=\"83\">\n                    <i data-lucide=\"activity\" class=\"w-4 h-4\" data-kid=\"84\"></i>\n                </div>\n                <span class=\"text-[10px] font-bold text-green-600 flex items-center gap-0.5\" data-kid=\"85\"><i data-lucide=\"arrow-up\" class=\"w-2 h-2\" data-kid=\"86\"></i> 12%</span>\n            </div>\n            <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-wider mb-1\" data-kid=\"87\">Active Assets</p>\n            <h4 class=\"font-outfit text-2xl font-bold text-gray-900\" data-kid=\"88\">4,812</h4>\n        </div>\n        <div class=\"kpi-card-anim glass-kpi w-44 p-5 rounded-[24px] shadow-2xl\" data-kid=\"89\">\n            <div class=\"flex justify-between items-start mb-3\" data-kid=\"90\">\n                <div class=\"w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center text-[var(--google-green)]\" data-kid=\"91\">\n                    <i data-lucide=\"check-circle-2\" class=\"w-4 h-4\" data-kid=\"92\"></i>\n                </div>\n                <span class=\"text-[10px] font-bold text-green-600 flex items-center gap-0.5\" data-kid=\"93\"><i data-lucide=\"arrow-up\" class=\"w-2 h-2\" data-kid=\"94\"></i> 4%</span>\n            </div>\n            <p class=\"text-[10px] text-gray-500 font-bold uppercase tracking-wider mb-1\" data-kid=\"95\">Delivery Success</p>\n            <h4 class=\"font-outfit text-2xl font-bold text-gray-900\" data-kid=\"96\">99.2%</h4>\n        </div>\n    </div>\n\n    \n    <div id=\"dock-bar\" class=\"absolute bottom-10 left-1/2 flex items-end gap-2 p-2.5 bg-white/80 backdrop-blur-3xl rounded-[32px] border border-white/40 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.15)] z-50\" data-kid=\"97\">\n        <button class=\"relative group w-14 h-14 rounded-2xl bg-[var(--google-blue)] text-white shadow-[0_8px_16px_-4px_rgba(66,133,244,0.4)] flex items-center justify-center hover:-translate-y-2 transition-transform\" data-kid=\"98\">\n            <i data-lucide=\"navigation-2\" class=\"w-6 h-6\" data-kid=\"99\"></i>\n        </button>\n        <button class=\"relative group w-14 h-14 rounded-2xl bg-white text-gray-600 border border-gray-100 shadow-sm flex items-center justify-center hover:bg-gray-50 hover:-translate-y-2 transition-transform\" data-kid=\"100\">\n            <i data-lucide=\"layers-2\" class=\"w-6 h-6\" data-kid=\"101\"></i>\n        </button>\n        <button class=\"relative group w-14 h-14 rounded-2xl bg-white text-gray-600 border border-gray-100 shadow-sm flex items-center justify-center hover:bg-gray-50 hover:-translate-y-2 transition-transform\" data-kid=\"102\">\n            <i data-lucide=\"cloud-sun\" class=\"w-6 h-6\" data-kid=\"103\"></i>\n        </button>\n        <div class=\"w-[1px] h-8 bg-gray-200 mx-1 mb-3\" data-kid=\"104\"></div>\n        <button class=\"relative group w-14 h-14 rounded-2xl bg-white text-gray-600 border border-gray-100 shadow-sm flex items-center justify-center hover:bg-gray-50 hover:-translate-y-2 transition-transform\" data-kid=\"105\">\n            <i data-lucide=\"bar-chart-3\" class=\"w-6 h-6\" data-kid=\"106\"></i>\n        </button>\n        <button class=\"relative group w-14 h-14 rounded-2xl bg-white text-gray-600 border border-gray-100 shadow-sm flex items-center justify-center hover:bg-gray-50 hover:-translate-y-2 transition-transform\" data-kid=\"107\">\n            <i data-lucide=\"settings\" class=\"w-6 h-6\" data-kid=\"108\"></i>\n        </button>\n    </div>\n\n    \n    <div class=\"absolute bottom-10 right-10 flex flex-col gap-2 z-50\" data-kid=\"109\">\n        <button class=\"w-12 h-12 bg-white rounded-xl shadow-lg border border-gray-100 flex items-center justify-center text-gray-600 hover:bg-gray-50 transition-colors\" data-kid=\"110\"><i data-lucide=\"plus\" class=\"w-5 h-5\" data-kid=\"111\"></i></button>\n        <button class=\"w-12 h-12 bg-white rounded-xl shadow-lg border border-gray-100 flex items-center justify-center text-gray-600 hover:bg-gray-50 transition-colors\" data-kid=\"112\"><i data-lucide=\"minus\" class=\"w-5 h-5\" data-kid=\"113\"></i></button>\n        <button class=\"w-12 h-12 bg-white rounded-xl shadow-lg border border-gray-100 flex items-center justify-center text-[var(--google-blue)] mt-4 hover:bg-blue-50 transition-colors\" data-kid=\"114\"><i data-lucide=\"crosshair\" class=\"w-5 h-5\" data-kid=\"115\"></i></button>\n    </div>\n\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"116\"></script>\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"117\"></script>\n<script type=\"module\" data-kid=\"118\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    if (window.lucide) {\n        window.lucide.createIcons();\n    }\n\n    window.addEventListener('load', () => {\n        gsap.set(['#floating-drawer', '.kpi-card-anim', '#dock-bar'], { visibility: 'visible' });\n\n        gsap.to('#floating-drawer', {\n            x: 0,\n            duration: 1.5,\n            ease: 'expo.out'\n        });\n\n        gsap.to('.kpi-card-anim', {\n            y: 0,\n            opacity: 1,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: 'back.out(1.2)',\n            delay: 0.3\n        });\n\n        gsap.to('#dock-bar', {\n            y: 0,\n            xPercent: -50,\n            duration: 1.5,\n            ease: 'elastic.out(1, 0.75)',\n            delay: 0.6\n        });\n\n        // Path animations\n        ['#route1', '#route2', '#route3'].forEach(id => {\n            const p = document.querySelector(id);\n            if (p) {\n                const len = p.getTotalLength();\n                p.style.strokeDasharray = len;\n                p.style.strokeDashoffset = len;\n                \n                animate(id, {\n                    strokeDashoffset: [len, 0],\n                    duration: 4000 + (Math.random() * 2000),\n                    easing: 'easeInOutSine',\n                    loop: true,\n                    direction: 'alternate'\n                });\n            }\n        });\n    });\n</script>\n",
