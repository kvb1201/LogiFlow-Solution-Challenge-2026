27\">\n        <div class=\"flex justify-between items-center mb-3\" data-kid=\"28\">\n          <span class=\"text-[10px] text-white/40 uppercase font-bold tracking-widest\" data-kid=\"29\">System Load</span>\n          <span class=\"text-[10px] text-green-400 font-bold\" data-kid=\"30\">STABLE</span>\n        </div>\n        <div class=\"w-full h-1.5 bg-white/10 rounded-full overflow-hidden\" data-kid=\"31\">\n          <div class=\"w-[34%] h-full bg-[#0070BB]\" data-kid=\"32\"></div>\n        </div>\n        <p class=\"text-[10px] text-white/60 mt-3 flex items-center gap-2\" data-kid=\"33\">\n          <span class=\"w-1.5 h-1.5 rounded-full bg-green-400\" data-kid=\"34\"></span>\n          Singapore Node Active\n        </p>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 p-8 overflow-y-auto\" data-kid=\"35\">\n    \n    <header class=\"flex justify-between items-center mb-8\" data-kid=\"36\">\n      <div data-kid=\"37\">\n        <h1 class=\"text-3xl font-heading font-extrabold text-[#004953]\" data-kid=\"38\">Control Dashboard</h1>\n        <p class=\"text-[#004953]/60 font-medium\" data-kid=\"39\">Monitoring 2,482 active shipments worldwide</p>\n      </div>\n\n      <div class=\"flex items-center gap-6\" data-kid=\"40\">\n        \n        <div class=\"relative hidden lg:block\" data-kid=\"41\">\n          <i class=\"ti ti-search absolute left-4 top-1/2 -translate-y-1/2 text-[#004953]/40\" data-kid=\"42\"></i>\n          <input type=\"text\" placeholder=\"Track Container ID...\" class=\"pl-11 pr-4 py-3 bg-white rounded-2xl border border-black/[0.05] text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#0070BB]/20 w-64 transition-all\" data-kid=\"43\">\n        </div>\n\n        \n        <div class=\"relative cursor-pointer group\" data-kid=\"44\">\n          <div class=\"w-12 h-12 glass-card flex items-center justify-center group-hover:bg-white transition-colors\" data-kid=\"45\">\n            <i class=\"ti ti-bell text-xl text