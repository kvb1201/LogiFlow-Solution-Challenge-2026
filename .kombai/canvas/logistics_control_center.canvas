lex items-center justify-center font-black\" data-kid=\"207\">FR</div>\n                  Paris Strategic Hub South\n                </div>\n              </td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"208\">MAN-TGX-18</td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"209\">TOMORROW <span class=\"text-[10px] block text-[#111]/70\" data-kid=\"210\">IN TRANSIT</span></td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"211\">\n                <span class=\"inline-block bg-[#4285F4] text-white px-4 py-1 text-[10px] font-black uppercase tracking-tighter border-[2px] border-[#111] brutalist-shadow-sm\" data-kid=\"212\">EN ROUTE</span>\n              </td>\n              <td class=\"px-6 py-4 text-center\" data-kid=\"213\">\n                <button class=\"bg-white border-[2px] border-[#111] px-4 py-1.5 brutalist-shadow-sm font-black text-[10px] uppercase hover:bg-[#111] hover:text-white transition-all cursor-pointer\" data-kid=\"214\">Intercept</button>\n              </td>\n            </tr>\n            <tr class=\"hover:bg-[#F4F4F0] transition-colors\" data-kid=\"215\">\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111] font-black\" data-kid=\"216\">#MANIFEST-88405</td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"217\">\n                <div class=\"flex items-center gap-3\" data-kid=\"218\">\n                  <div class=\"w-6 h-6 bg-[#111] text-white text-[10px] flex items-center justify-center font-black\" data-kid=\"219\">NL</div>\n                  Amsterdam Port Terminal 1\n                </div>\n              </td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"220\">DAF-XF-2024</td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"221\">10:15 TOMORROW <span class=\"text-[10px] block text-[#111]/70\" data-kid=\"222\">SCHEDULED</span></td>\n              <td class=\"px-6 py-4 border-r-[4px] border-[#111]\" data-kid=\"223\">\n                <span class=\"inline-block bg-[#FBBC05] text-[#111] px-4 py-1 text-[10px] font-black uppercase tracking-tighter border-[2px] border-[#111] brutalist-shadow-sm\" data-kid=\"224\">LOAD PENDING</span>\n              </td>\n              <td class=\"px-6 py-4 text-center\" data-kid=\"225\">\n                <button class=\"bg-white border-[2px] border-[#111] px-4 py-1.5 brutalist-shadow-sm font-black text-[10px] uppercase hover:bg-[#111] hover:text-white transition-all cursor-pointer\" data-kid=\"226\">Intercept</button>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        <div class=\"p-6 bg-[#111]/5 flex flex-col md:flex-row items-center justify-between gap-6 border-t-[4px] border-[#111]\" data-kid=\"227\">\n          <p class=\"text-xs font-black uppercase text-[#111]/70\" data-kid=\"228\">Showing 4 of 1,284 manifests // Matrix synchronization active</p>\n          <div class=\"flex gap-3\" data-kid=\"229\">\n            <button class=\"w-10 h-10 flex items-center justify-center border-[3px] border-[#111] bg-white font-black text-sm brutalist-shadow-sm hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all cursor-pointer\" data-kid=\"230\">1</button>\n            <button class=\"w-10 h-10 flex items-center justify-center border-[3px] border-[#111] bg-[#111] text-white font-black text-sm brutalist-shadow-sm cursor-pointer\" data-kid=\"231\">2</button>\n            <button class=\"w-10 h-10 flex items-center justify-center border-[3px] border-[#111] bg-white font-black text-sm brutalist-shadow-sm hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all cursor-pointer\" data-kid=\"232\">3</button>\n            <button class=\"w-10 h-10 flex items-center justify-center border-[3px] border-[#111] bg-white font-black text-sm brutalist-shadow-sm hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all cursor-pointer\" data-kid=\"233\"><i class=\"ti ti-chevron-right\" data-kid=\"234\"></i></button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  \n  <footer class=\"border-t-[4px] border-[#111] bg-white py-12\" data-kid=\"235\">\n    <div class=\"max-w-[1440px] mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"236\">\n      <div class=\"flex items-center gap-4\" data-kid=\"237\">\n        <div class=\"w-12 h-12 bg-[#111] border-[3px] border-[#111] brutalist-shadow-sm flex items-center justify-center text-white font-black text-xl\" data-kid=\"238\">L</div>\n        <div data-kid=\"239\">\n          <h4 class=\"font-['Space_Grotesk'] font-black text-xl uppercase tracking-tighter\" data-kid=\"240\">Logistics Intelligence OS</h4>\n          <p class=\"text-[10px] font-black uppercase text-[#111]/70 tracking-widest\" data-kid=\"241\">© 2026 NEO-SWISS CONTROL SYSTEMS // UNIT 01</p>\n        </div>\n      </div>\n      <div class=\"flex gap-8 font-['Space_Grotesk'] font-extrabold text-[10px] uppercase tracking-widest opacity-80\" data-kid=\"242\">\n        <a href=\"#\" class=\"hover:text-[#111] transition-colors\" data-kid=\"243\">Privacy Protocal</a>\n        <a href=\"#\" class=\"hover:text-[#111] transition-colors\" data-kid=\"244\">Security Manifest</a>\n        <a href=\"#\" class=\"hover:text-[#111] transition-colors\" data-kid=\"245\">API Endpoint</a>\n        <a href=\"#\" class=\"hover:text-[#111] transition-colors\" data-kid=\"246\">Terminal Log</a>\n      </div>\n    </div>\n  </footer>\n\n  \n  <script data-kid=\"247\">\n    document.addEventListener('DOMContentLoaded', () => {\n      if (typeof gsap !== 'undefined') {\n        // Hover Lift on Stats\n        const statCards = document.querySelectorAll(\".stat-card\");\n        statCards.forEach(card => {\n          const accent = card.querySelector(\".stat-accent\");\n          card.addEventListener('mouseenter', () => {\n            gsap.to(card, { y: -8, scale: 1.02, duration: 0.3, ease: \"power2.out\" });\n            if(accent) gsap.to(accent, { rotation: 90, scale: 1.2, duration: 0.5, ease: \"power2.out\" });\n          });\n          card.addEventListener('mouseleave', () => {\n            gsap.to(card, { y: 0, scale: 1, duration: 0.3, ease: \"power2.out\" });\n            if(accent) gsap.to(accent, { rotation: 45, scale: 1, duration: 0.5, ease: \"power2.out\" });\n          });\n        });\n\n        // Stagger Alerts on Enter\n        gsap.from(\".alert-item\", {\n          scrollTrigger: {\n            trigger: \".alert-list\",\n            start: \"top 80%\",\n          },\n          opacity: 0,\n          y: 20,\n          stagger: 0.1,\n          duration: 0.6,\n          ease: \"power2.out\"\n        });\n\n        // Subtle table row entrance\n        gsap.from(\"tbody tr\", {\n          scrollTrigger: {\n            trigger: \"table\",\n            start: \"top 95%\",\n          },\n          opacity: 0,\n          x: -10,\n          stagger: 0.05,\n          duration: 0.4,\n          ease: \"power2.out\"\n        });\n\n        // Map interaction\n        const mapContainer = document.querySelector(\".lg\\\\:col-span-8\");\n        const mapImg = mapContainer?.querySelector(\".map-image\");\n        if(mapContainer && mapImg) {\n          mapContainer.addEventListener('mouseenter', () => {\n            gsap.to(mapImg, { scale: 1.05, duration: 1.2, ease: \"power1.inOut\" });\n          });\n          mapContainer.addEventListener('mouseleave', () => {\n            gsap.to(mapImg, { scale: 1, duration: 1.2, ease: \"power1.inOut\" });\n          });\n        }\n      }\n    });\n  </script>\n</div>\n",
