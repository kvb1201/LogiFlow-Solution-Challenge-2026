lass=\"text-lg font-bold text-slate-800\" data-kid=\"188\">Operational Log: Critical Tracking</h3>\n                        <div class=\"px-3 py-1 bg-blue-50 text-[var(--google-blue)] text-[10px] font-bold rounded-full border border-blue-100 uppercase tracking-wide\" data-kid=\"189\">Live Feed</div>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"190\">\n                        <div class=\"flex items-center bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 focus-within:ring-2 ring-blue-100 transition-all\" data-kid=\"191\">\n                            <i class=\"lucide-filter w-4 h-4 text-slate-400 mr-2\" data-kid=\"192\"></i>\n                            <select class=\"bg-transparent border-none text-xs font-bold text-slate-600 outline-none\" data-kid=\"193\">\n                                <option data-kid=\"194\">Priority: All</option>\n                                <option data-kid=\"195\">Priority: High</option>\n                                <option data-kid=\"196\">Status: Delayed</option>\n                            </select>\n                        </div>\n                        <button class=\"flex items-center gap-2 px-5 py-2 bg-[var(--google-blue)] text-white text-xs font-bold rounded-xl hover:bg-blue-600 transition-all shadow-md shadow-blue-500/20\" data-kid=\"197\">\n                            <i class=\"lucide-download w-4 h-4\" data-kid=\"198\"></i> Export Manifest\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"overflow-x-auto\" data-kid=\"199\">\n                    <table class=\"w-full text-left\" data-kid=\"200\">\n                        <thead class=\"bg-slate-50/50\" data-kid=\"201\">\n                            <tr class=\"text-[10px] font-extrabold text-slate-400 uppercase tracking-[0.15em]\" data-kid=\"202\">\n                                <th class=\"px-8 py-4\" data-kid=\"203\">Tracking Reference</th>\n                                <th class=\"px-8 py-4\" data-kid=\"204\">Current Vector</th>\n                                <th class=\"px-8 py-4\" data-kid=\"205\">ETA Window</th>\n                                <th class=\"px-8 py-4\" data-kid=\"206\">Asset Type</th>\n                                <th class=\"px-8 py-4\" data-kid=\"207\">Load Factor</th>\n                                <th class=\"px-8 py-4\" data-kid=\"208\">Status</th>\n                                <th class=\"px-8 py-4 text-right\" data-kid=\"209\">Ops</th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-slate-50\" data-kid=\"210\">\n                            \n                            <tr class=\"hover:bg-blue-50/30 transition-colors group\" data-kid=\"211\">\n                                <td class=\"px-8 py-4\" data-kid=\"212\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"213\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[var(--google-blue)]\" data-kid=\"214\"></div>\n                                        <span class=\"mono text-xs font-bold text-slate-700 tracking-tight\" data-kid=\"215\">X-4912-DELTA-HUB</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"216\">\n                                    <div class=\"flex flex-col\" data-kid=\"217\">\n                                        <span class=\"text-xs font-bold text-slate-800\" data-kid=\"218\">Singapore (SGP) → Rotterdam (NLD)</span>\n                                        <span class=\"text-[9px] text-slate-400 font-bold uppercase mt-0.5\" data-kid=\"219\">Maritime Route A4</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"220\">\n                                    <span class=\"text-xs text-slate-600 font-medium\" data-kid=\"221\">May 24, 2024</span>\n                                    <span class=\"text-[10px] text-slate-400 font-bold ml-1 uppercase\" data-kid=\"222\">14:20 UTC</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"223\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"224\">\n                                        <i class=\"lucide-ship w-3.5 h-3.5 text-slate-400\" data-kid=\"225\"></i>\n                                        <span class=\"text-[10px] font-bold text-slate-600 uppercase tracking-tight\" data-kid=\"226\">Post-Panamax</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"227\">\n                                    <div class=\"w-24 bg-slate-100 h-1.5 rounded-full overflow-hidden\" data-kid=\"228\">\n                                        <div class=\"bg-[var(--google-blue)] h-full w-[92%] rounded-full\" data-kid=\"229\"></div>\n                                    </div>\n                                    <span class=\"text-[9px] font-bold text-slate-400 uppercase mt-1 block\" data-kid=\"230\">92.4% Utility</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"231\">\n                                    <div class=\"flex items-center gap-1.5 px-2.5 py-1 bg-blue-100 text-[var(--google-blue)] rounded-full text-[9px] font-black uppercase tracking-widest border border-blue-200\" data-kid=\"232\">\n                                        <i class=\"lucide-anchor w-2.5 h-2.5\" data-kid=\"233\"></i> In Transit\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4 text-right\" data-kid=\"234\">\n                                    <button class=\"p-2 text-slate-300 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-all opacity-0 group-hover:opacity-100\" data-kid=\"235\"><i class=\"lucide-eye w-4 h-4\" data-kid=\"236\"></i></button>\n                                </td>\n                            </tr>\n                            \n                            <tr class=\"hover:bg-blue-50/30 transition-colors group\" data-kid=\"237\">\n                                <td class=\"px-8 py-4\" data-kid=\"238\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"239\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[var(--google-red)]\" data-kid=\"240\"></div>\n                                        <span class=\"mono text-xs font-bold text-slate-700 tracking-tight\" data-kid=\"241\">A-1108-AIR-X</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"242\">\n                                    <div class=\"flex flex-col\" data-kid=\"243\">\n                                        <span class=\"text-xs font-bold text-slate-800\" data-kid=\"244\">Memphis (MEM) → London (LHR)</span>\n                                        <span class=\"text-[9px] text-slate-400 font-bold uppercase mt-0.5\" data-kid=\"245\">Air Corridor Z2</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"246\">\n                                    <span class=\"text-xs text-slate-600 font-medium\" data-kid=\"247\">May 21, 2024</span>\n                                    <span class=\"text-[10px] text-red-400 font-bold ml-1 uppercase\" data-kid=\"248\">Delayed +4H</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"249\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"250\">\n                                        <i class=\"lucide-plane w-3.5 h-3.5 text-slate-400\" data-kid=\"251\"></i>\n                                        <span class=\"text-[10px] font-bold text-slate-600 uppercase tracking-tight\" data-kid=\"252\">Cargo B777</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"253\">\n                                    <div class=\"w-24 bg-slate-100 h-1.5 rounded-full overflow-hidden\" data-kid=\"254\">\n                                        <div class=\"bg-[var(--google-red)] h-full w-[45%] rounded-full\" data-kid=\"255\"></div>\n                                    </div>\n                                    <span class=\"text-[9px] font-bold text-slate-400 uppercase mt-1 block\" data-kid=\"256\">45.0% Utility</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"257\">\n                                    <div class=\"flex items-center gap-1.5 px-2.5 py-1 bg-red-100 text-[var(--google-red)] rounded-full text-[9px] font-black uppercase tracking-widest border border-red-200\" data-kid=\"258\">\n                                        <i class=\"lucide-alert-triangle w-2.5 h-2.5\" data-kid=\"259\"></i> Delayed\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4 text-right\" data-kid=\"260\">\n                                    <button class=\"p-2 text-slate-300 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-all opacity-0 group-hover:opacity-100\" data-kid=\"261\"><i class=\"lucide-eye w-4 h-4\" data-kid=\"262\"></i></button>\n                                </td>\n                            </tr>\n                            \n                            <tr class=\"hover:bg-blue-50/30 transition-colors group\" data-kid=\"263\">\n                                <td class=\"px-8 py-4\" data-kid=\"264\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"265\">\n                                        <div class=\"w-2 h-2 rounded-full bg-[var(--google-green)]\" data-kid=\"266\"></div>\n                                        <span class=\"mono text-xs font-bold text-slate-700 tracking-tight\" data-kid=\"267\">G-7721-RAIL-S</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"268\">\n                                    <div class=\"flex flex-col\" data-kid=\"269\">\n                                        <span class=\"text-xs font-bold text-slate-800\" data-kid=\"270\">Berlin (BER) → Warsaw (WAW)</span>\n                                        <span class=\"text-[9px] text-slate-400 font-bold uppercase mt-0.5\" data-kid=\"271\">Rail Line E30</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"272\">\n                                    <span class=\"text-xs text-slate-600 font-medium\" data-kid=\"273\">May 21, 2024</span>\n                                    <span class=\"text-[10px] text-slate-400 font-bold ml-1 uppercase\" data-kid=\"274\">Arrived</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"275\">\n                                    <div class=\"flex items-center gap-2\" data-kid=\"276\">\n                                        <i class=\"lucide-train w-3.5 h-3.5 text-slate-400\" data-kid=\"277\"></i>\n                                        <span class=\"text-[10px] font-bold text-slate-600 uppercase tracking-tight\" data-kid=\"278\">Intermodal Rail</span>\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"279\">\n                                    <div class=\"w-24 bg-slate-100 h-1.5 rounded-full overflow-hidden\" data-kid=\"280\">\n                                        <div class=\"bg-[var(--google-green)] h-full w-[100%] rounded-full\" data-kid=\"281\"></div>\n                                    </div>\n                                    <span class=\"text-[9px] font-bold text-slate-400 uppercase mt-1 block\" data-kid=\"282\">Full Capacity</span>\n                                </td>\n                                <td class=\"px-8 py-4\" data-kid=\"283\">\n                                    <div class=\"flex items-center gap-1.5 px-2.5 py-1 bg-green-100 text-[var(--google-green)] rounded-full text-[9px] font-black uppercase tracking-widest border border-green-200\" data-kid=\"284\">\n                                        <i class=\"lucide-check-circle w-2.5 h-2.5\" data-kid=\"285\"></i> Delivered\n                                    </div>\n                                </td>\n                                <td class=\"px-8 py-4 text-right\" data-kid=\"286\">\n                                    <button class=\"p-2 text-slate-300 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-all opacity-0 group-hover:opacity-100\" data-kid=\"287\"><i class=\"lucide-eye w-4 h-4\" data-kid=\"288\"></i></button>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n\n                <div class=\"px-8 py-6 bg-slate-50/50 flex items-center justify-between\" data-kid=\"289\">\n                    <span class=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]\" data-kid=\"290\">Showing 3 of 1,248 shipment entries</span>\n                    <div class=\"flex items-center gap-2\" data-kid=\"291\">\n                        <button class=\"w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-400 hover:bg-slate-100 disabled:opacity-50 transition-colors\" disabled data-kid=\"292\">\n                            <i class=\"lucide-chevron-left w-4 h-4\" data-kid=\"293\"></i>\n                        </button>\n                        <button class=\"w-8 h-8 rounded-lg bg-[var(--google-blue)] text-white text-xs font-bold shadow-md shadow-blue-500/20\" data-kid=\"294\">1</button>\n                        <button class=\"w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors\" data-kid=\"295\">2</button>\n                        <button class=\"w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors\" data-kid=\"296\">3</button>\n                        <button class=\"w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors\" data-kid=\"297\">\n                            <i class=\"lucide-chevron-right w-4 h-4\" data-kid=\"298\"></i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"299\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"300\"></script>\n<script type=\"module\" data-kid=\"301\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    // Initialize Marquee Ticker\n    const tickerTrack = document.querySelector('.ticker-track');\n    // Duplicate content for seamless loop\n    const originalContent = tickerTrack.innerHTML;\n    tickerTrack.innerHTML += originalContent;\n    tickerTrack.innerHTML += originalContent; // Triple for safety in wide screens\n\n    animate('.ticker-track', {\n        translateX: ['0%', '-33.33%'],\n        duration: 40000,\n        loop: true,\n        easing: 'linear'\n    });\n\n    // Populate Heatmap\n    const heatmapGrid = document.getElementById('heatmap-grid');\n    const intensities = ['bg-blue-50', 'bg-blue-100', 'bg-blue-200', 'bg-blue-300', 'bg-blue-400', 'bg-blue-500', 'bg-blue-600', 'bg-blue-700', 'bg-blue-800', 'bg-blue-900'];\n    \n    for (let i = 0; i < 84; i++) {\n        const cell = document.createElement('div');\n        const randIdx = Math.floor(Math.pow(Math.random(), 1.5) * intensities.length);\n        cell.className = `w-full h-full rounded-sm heatmap-cell ${intensities[randIdx]} cursor-pointer`;\n        heatmapGrid.appendChild(cell);\n    }\n\n    // KPI Entry Animations\n    // Corrected: use class-based selector instead of > child combinator\n    gsap.from('.tile-card', {\n        y: 30,\n        opacity: 0,\n        duration: 0.8,\n        stagger: 0.1,\n        ease: \"power3.out\"\n    });\n\n    // Sidebar link interactions\n    document.querySelectorAll('aside nav a').forEach(link => {\n        link.addEventListener('mouseenter', () => {\n            if (!link.classList.contains('bg-blue-50')) {\n                gsap.to(link, { x: 4, duration: 0.2, ease: \"power1.out\" });\n            }\n        });\n        link.addEventListener('mouseleave', () => {\n            if (!link.classList.contains('bg-blue-50')) {\n                gsap.to(link, { x: 0, duration: 0.2, ease: \"power1.out\" });\n            }\n        });\n    });\n</script>",
