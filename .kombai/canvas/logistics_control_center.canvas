 justify-between items-end border-b border-white/20 pb-2\" data-kid=\"78\">\n              <div data-kid=\"79\">\n                <p class=\"text-[10px] text-[#004953]/60 font-bold uppercase tracking-widest\" data-kid=\"80\">Destination</p>\n                <p class=\"text-lg font-bold text-[#004953]\" data-kid=\"81\">Rotterdam (RTM)</p>\n              </div>\n              <p class=\"text-xs font-medium text-[#004953]/60\" data-kid=\"82\">ETA: June 04</p>\n            </div>\n          </div>\n\n          <div class=\"mt-8 flex gap-3\" data-kid=\"83\">\n            <button class=\"flex-1 bg-[#004953] text-white py-3 rounded-xl font-bold text-sm shadow-xl shadow-[#004953]/20 hover:bg-[#00363e] transition-colors\" data-kid=\"84\">Track Full Route</button>\n            <button class=\"w-12 h-12 bg-white/60 rounded-xl flex items-center justify-center hover:bg-white transition-colors\" data-kid=\"85\">\n              <i class=\"ti ti-download text-[#004953]\" data-kid=\"86\"></i>\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute bottom-8 right-8 flex gap-4\" data-kid=\"87\">\n            <div class=\"px-4 py-2 frosted-overlay flex items-center gap-2\" data-kid=\"88\">\n                <span class=\"w-2 h-2 rounded-full bg-green-400\" data-kid=\"89\"></span>\n                <span class=\"text-xs font-bold text-[#004953]\" data-kid=\"90\">Normal Traffic</span>\n            </div>\n            <div class=\"px-4 py-2 frosted-overlay flex items-center gap-2\" data-kid=\"91\">\n                <span class=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\" data-kid=\"92\"></span>\n                <span class=\"text-xs font-bold text-[#004953]\" data-kid=\"93\">Advisory Zones</span>\n            </div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-1 row-span-1 glass-card p-6 flex flex-col group hover:border-[#0070BB]/20 transition-all\" data-kid=\"94\">\n        <div class=\"flex items-center justify-bet