      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/lucide-static@0.16.29/font/lucide.css');\n\n    :root {\n        --google-blue: #4285F4;\n        --google-red: #EA4335;\n        --google-yellow: #FBBC05;\n        --google-green: #34A853;\n        --bg-surface: #EBF1FB;\n    }\n\n    .font-plus { font-family: 'Plus_Jakarta_Sans', sans-serif; }\n    .mono { font-family: 'Roboto_Mono', monospace; }\n\n    .ticker-container {\n        background-color: #0f172a;\n        height: 40px;\n        overflow: hidden;\n        display: flex;\n        align-items: center;\n        position: relative;\n    }\n\n    .ticker-label {\n        position: absolute;\n        left: 0;\n        top: 0;\n        bottom: 0;\n        z-index: 10;\n        background: #0f172a;\n        padding: 0 1.5rem;\n        display: flex;\n        align-items: center;\n        font-size: 0.65rem;\n        font-weight: 800;\n        color: #94a3b8;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        border-right: 1px solid #1e293b;\n    }\n\n    .ticker-track {\n        display: flex;\n        align-items: center;\n        gap: 4rem;\n        white-space: nowrap;\n        padding-left: 140px;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar {\n        width: 6px;\n    }\n    .custom-scrollbar::-webkit-scrollbar-track {\n        background: transparent;\n    }\n    .custom-scrollbar::-webkit-scrollbar-thumb {\n        background: #cbd5e1;\n        border-radius: 10px;\n    }\n    \n    .heatmap-cell {\n        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n    .heatmap-cell:hover {\n        transform: scale(1.1);\n        z-index: 10;\n        box-shadow: 0 0 10px rgba(66, 133, 244, 0.3);\n    }\n\n    /* GSAP targets should not have transitions */\n    .tile-card {\n        will-change: transform, opacity;\n    }\n</style>\n\n<div class=\"flex h-screen overflow-hidden bg-[#EBF1FB] font-plus\" data-kid=\"1\">\n    \n    <aside id=\"sidebar-dashboard\" class=\"w-72 bg-white border-r border-blue-100 flex flex-col shrink-0 z-30\" data-kid=\"2\">\n        <div class=\"p-6 border-b border-slate-50 flex items-center gap-3\" data-kid=\"3\">\n            <div class=\"w-10 h-10 bg-[var(--google-blue)] rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30\" data-kid=\"4\">\n                <i class=\"lucide-activity text-white text-xl\" data-kid=\"5\"></i>\n            </div>\n            <div data-kid=\"6\">\n                <h1 class=\"text-lg font-bold text-slate-800 tracking-tight leading-none\" data-kid=\"7\">LogiCentral</h1>\n                <p class=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1\" data-kid=\"8\">Analytics Hub</p>\n            </div>\n        </div>\n\n        <div class=\"flex-1 overflow-y-auto custom-scrollbar p-4 space-y-8\" data-kid=\"9\">\n            <div data-kid=\"10\">\n                <p class=\"px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"11\">Fleet Management</p>\n                <nav class=\"space-y-1\" data-kid=\"12\">\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 bg-blue-50 text-[var(--google-blue)] rounded-2xl font-bold group\" data-kid=\"13\">\n                        <i class=\"lucide-layout-grid w-5 h-5\" data-kid=\"14\"></i>\n                        <span data-kid=\"15\">Dashboard</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all group\" data-kid=\"16\">\n                        <i class=\"lucide-map-pin w-5 h-5 group-hover:text-[var(--google-blue)]\" data-kid=\"17\"></i>\n                        <span data-kid=\"18\">Real-time Map</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all group\" data-kid=\"19\">\n                        <i class=\"lucide-navigation w-5 h-5 group-hover:text-[var(--google-blue)]\" data-kid=\"20\"></i>\n                        <span data-kid=\"21\">Routes</span>\n                        <span class=\"ml-auto bg-[var(--google-red)] text-white text-[10px] px-1.5 py-0.5 rounded-full\" data-kid=\"22\">4</span>\n                    </a>\n                </nav>\n            </div>\n\n            <div data-kid=\"23\">\n                <p class=\"px-4 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-2\" data-kid=\"24\">Shipment Data</p>\n                <nav class=\"space-y-1\" data-kid=\"25\">\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all group\" data-kid=\"26\">\n                        <i class=\"lucide-package w-5 h-5 group-hover:text-[var(--google-blue)]\" data-kid=\"27\"></i>\n                        <span data-kid=\"28\">Active Loads</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all group\" data-kid=\"29\">\n                        <i class=\"lucide-clipboard-list w-5 h-5 group-hover:text-[var(--google-blue)]\" data-kid=\"30\"></i>\n                        <span data-kid=\"31\">Inventory</span>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-2xl transition-all group\" data-kid=\"32\">\n                        <i class=\"lucide-history w-5 h-5 group-hover:text-[var(--google-blue)]\" data-kid=\"33\"></i>\n                        <span data-kid=\"34\">Archives</span>\n                    </a>\n                </nav>\n            </div>\n\n            <div class=\"bg-slate-900 rounded-3xl p-5 text-white relative overflow-hidden\" data-kid=\"35\">\n                <div class=\"relative z-10\" data-kid=\"36\">\n                    <p class=\"text-xs font-bold text-blue-300 uppercase mb-1\" data-kid=\"37\">Fuel Report</p>\n                    <h4 class=\"text-xl font-bold mb-4 leading-tight\" data-kid=\"38\">Optimization Potential: 14%</h4>\n                    <button class=\"w-full py-2 bg-[var(--google-blue)] rounded-xl text-xs font-bold hover:bg-blue-600 transition-colors\" data-kid=\"39\">View Deep Dive</button>\n                </div>\n                <div class=\"absolute -right-4 -bottom-4 w-24 h-24 bg-white/5 rounded-full blur-2xl\" data-kid=\"40\"></div>\n            </div>\n        </div>\n\n        <div class=\"p-6 border-t border-slate-50\" data-kid=\"41\">\n            <div class=\"flex items-center gap-3\" data-kid=\"42\">\n                <div class=\"w-10 h-10 rounded-full overflow-hidden ring-2 ring-blue-50\" data-kid=\"43\">\n                    <img src=\"https://i.pravatar.cc/100?u=sarah\" alt=\"Profile\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"44\">\n                </div>\n                <div class=\"flex-1 min-w-0\" data-kid=\"45\">\n                    <p class=\"text-sm font-bold text-slate-800 truncate\" data-kid=\"46\">Sarah Jensen</p>\n                    <p class=\"text-[10px] text-slate-400 font-bold uppercase truncate\" data-kid=\"47\">Operations Lead</p>\n                </div>\n                <button class=\"text-slate-400 hover:text-slate-600\" data-kid=\"48\"><i class=\"lucide-log-out w-4 h-4\" data-kid=\"49\"></i></button>\n            </div>\n        </div>\n    </aside>\n\n    \n    <div class=\"flex-1 flex flex-col overflow-hidden\" data-kid=\"50\">\n        \n        <header class=\"h-16 px-8 bg-white/80 backdrop-blur-md border-b border-blue-50 flex items-center justify-between shrink-0 z-20\" data-kid=\"51\">\n            <div class=\"flex items-cente