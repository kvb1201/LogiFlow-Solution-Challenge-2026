enter justify-center\" data-kid=\"80\">\n                            <i class=\"ti ti-clock-exclamation text-xl text-red-500\" data-kid=\"81\"></i>\n                        </div>\n                        <div data-kid=\"82\">\n                            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-wider\" data-kid=\"83\">Time Critical</p>\n                            <div class=\"flex items-center gap-2\" data-kid=\"84\">\n                                <p class=\"text-xl font-heading font-bold text-[var(--color-navy)]\" data-kid=\"85\">14</p>\n                                <span class=\"text-[10px] bg-red-100 text-red-600 px-1.5 py-0.5 rounded font-bold\" data-kid=\"86\">+2.4%</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-4\" data-kid=\"87\">\n                        <div class=\"w-10 h-10 bg-gray-50 rounded-lg flex items-center justify-center\" data-kid=\"88\">\n                            <i class=\"ti ti-leaf text-xl text-[var(--color-emerald)]\" data-kid=\"89\"></i>\n                        </div>\n                        <div data-kid=\"90\">\n                            <p class=\"text-[10px] text-gray-400 font-bold uppercase tracking-wider\" data-kid=\"91\">ECO-Efficiency</p>\n                            <p class=\"text-xl font-heading font-bold text-[var(--color-navy)]\" data-kid=\"92\">92.4%</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-8 pt-8 border-t border-gray-100\" data-kid=\"93\">\n                    <button class=\"w-full bg-[var(--color-navy)] text-white py-3 rounded-xl text-xs font-bold font-heading hover:bg-[#002850] transition-all shadow-lg shadow-navy-900/20 active:scale-95\" data-kid=\"94\">SYSTEM DIAGNOSTICS</button>\n                    <button class=\"w-full mt-3 bg-white text-[var(--color-navy)] border border-gray-200 py-3 rounded-xl text-xs font-bold font-heading hover:bg-gray-50 transition-all\" data-kid=\"95\">TERMINAL MAPS</button>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"absolute bottom-6 right-8 flex gap-4\" data-kid=\"96\">\n            <div class=\"flex items-center gap-2 bg-white/90 backdrop-blur px-3 py-1.5 rounded-full border border-gray-200 shadow-sm\" data-kid=\"97\">\n                <span class=\"w-2 h-2 rounded-full bg-[var(--color-emerald)]\" data-kid=\"98\"></span>\n                <span class=\"text-[10px] font-bold text-gray-600\" data-kid=\"99\">Optimal Flow</span>\n            </div>\n            <div class=\"flex items-center gap-2 bg-white/90 backdrop-blur px-3 py-1.5 rounded-full border border-gray-200 shadow-sm\" data-kid=\"100\">\n                <span class=\"w-2 h-2 rounded-full bg-orange-400\" data-kid=\"101\"></span>\n                <span class=\"text-[10px] font-bold text-gray-600\" data-kid=\"102\">Processing</span>\n            </div>\n            <div class=\"flex items-center gap-2 bg-white/90 backdrop-blur px-3 py-1.5 rounded-full border border-gray-200 shadow-sm\" data-kid=\"103\">\n                <span class=\"w-2 h-2 rounded-full bg-red-500\" data-kid=\"104\"></span>\n                <span class=\"text-[10px] font-bold text-gray-600\" data-kid=\"105\">High Delay</span>\n            </div>\n        </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 mb-12 border border-gray-100 rounded-3xl overflow-hidden bg-white shadow-xs\" data-kid=\"106\">\n        <div class=\"p-6 border-r border-gray-50 hover:bg-gray-50/50 transition-all group\" data-kid=\"107\">\n            <div class=\"flex justify-between items-start mb-4\" data-kid=\"108\">\n                <p class=\"text-[10px] font-heading font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"109\">On-Time Index</p>\n                <i class=\"ti ti-chart-dots text-gray-300 group-hover:text-[var(--color-emerald)] transition-colors\" data-kid=\"110\"></i>\n            </div>\n            <div class=\"flex items-end justify-between\" data-kid=\"111\">\n                <h4 class=\"text-3xl font-heading font-extrabold text-[var(--color-navy)] tracking-tighter\" data-kid=\"112\">94.8%</h4>\n                <div class=\"flex items-center gap-1 text-[var(--color-emerald)] font-bold text-xs\" data-kid=\"113\">\n                    <i class=\"ti ti-trending-up\" data-kid=\"114\"></i>\n                    <span data-kid=\"115\">+1.2%</span>\n                </div>\n            </div>\n        </div>\n        <div class=\"p-6 border-r border-gray-50 hover:bg-gray-50/50 transition-all group\" data-kid=\"116\">\n            <div class=\"flex justify-between items-start mb-4\" data-kid=\"117\">\n                <p class=\"text-[10px] font-heading font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"118\">Active Corridors</p>\n                <i class=\"ti ti-route text-gray-300 group-hover:text-[var(--color-navy)] transition-colors\" data-kid=\"119\"></i>\n            </div>\n            <div class=\"flex items-end justify-between\" data-kid=\"120\">\n                <h4 class=\"text-3xl font-heading font-extrabold text-[var(--color-navy)] tracking-tighter\" data-kid=\"121\">842</h4>\n                <div class=\"flex items-center gap-1 text-gray-400 font-bold text-xs\" data-kid=\"122\">\n                    <span data-kid=\"123\">Stable</span>\n                </div>\n            </div>\n        </div>\n        <div class=\"p-6 border-r border-gray-50 hover:bg-gray-50/50 transition-all group\" data-kid=\"124\">\n            <div class=\"flex justify-between items-start mb-4\" data-kid=\"125\">\n                <p class=\"text-[10px] font-heading font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"126\">Avg Clearance</p>\n                <i class=\"ti ti-scan text-gray-300 group-hover:text-blue-500 transition-colors\" data-kid=\"127\"></i>\n            <