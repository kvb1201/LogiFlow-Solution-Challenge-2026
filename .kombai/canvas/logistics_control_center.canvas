      "html": "\n<div class=\"flex min-h-screen w-full bg-[#FDFDFC] text-[#0A0A0A] font-['Archivo'] selection:bg-black selection:text-white\" data-kid=\"0\">\n    \n    <aside id=\"branded-sidebar\" class=\"w-72 h-screen sticky top-0 bg-[#FBBC05] border-r-3 border-black flex flex-col shrink-0 z-50\" data-kid=\"1\">\n        <div class=\"p-8 border-b-3 border-black\" data-kid=\"2\">\n            <h1 class=\"text-4xl font-black uppercase tracking-tighter leading-[0.85] text-black\" data-kid=\"3\">\n                BRUTAL<br data-kid=\"4\">HUB\n            </h1>\n            <p class=\"font-['Roboto_Mono'] text-[10px] mt-2 font-bold opacity-60 uppercase\" data-kid=\"5\">Logistics Ctrl Center v4.0</p>\n        </div>\n        \n        <nav class=\"flex-1 py-12\" data-kid=\"6\">\n            <a href=\"#\" class=\"flex items-center gap-5 px-8 py-5 border-y-3 border-transparent hover:bg-black hover:text-white transition-none group\" data-kid=\"7\">\n                <i class=\"ti ti-truck-delivery text-3xl\" data-kid=\"8\"></i>\n                <span class=\"font-black uppercase tracking-tight text-lg\" data-kid=\"9\">Active Fleet</span>\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-5 px-8 py-5 border-b-3 border-transparent hover:bg-black hover:text-white transition-none group\" data-kid=\"10\">\n                <i class=\"ti ti-box-multiple text-3xl\" data-kid=\"11\"></i>\n                <span class=\"font-black uppercase tracking-tight text-lg\" data-kid=\"12\">Material Hub</span>\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-5 px-8 py-5 border-b-3 border-transparent hover:bg-black hover:text-white transition-none group\" data-kid=\"13\">\n                <i class=\"ti ti-map-pin-filled text-3xl\" data-kid=\"14\"></i>\n                <span class=\"font-black uppercase tracking-tight text-lg\" data-kid=\"15\">Node Tracking</span>\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-5 px-8 py-5 border-b-3 border-transparent hover:bg-black hover:text-white transition-none group\" data-kid=\"16\">\n                <i class=\"ti ti-urgent text-3xl\" data-kid=\"17\"></i>\n                <span class=\"font-black uppercase tracking-tight text-lg\" data-kid=\"18\">System Logs</span>\n            </a>\n        </nav>\n\n        <div class=\"p-8 border-t-3 border-black bg-white/30 backdrop-blur-sm\" data-kid=\"19\">\n            <div class=\"flex items-center gap-4\" data-kid=\"20\">\n                <div class=\"w-12 h-12 bg-black border-2 border-black flex items-center justify-center text-white\" data-kid=\"21\">\n                    <i class=\"ti ti-user-code text-2xl\" data-kid=\"22\"></i>\n                </div>\n                <div data-kid=\"23\">\n                    <p class=\"font-black text-xs uppercase\" data-kid=\"24\">Admin_Node_7</p>\n                    <div class=\"flex items-center gap-1.5 font-['Roboto_Mono'] text-[10px] text-green-700 font-bold\" data-kid=\"25\">\n                        <span class=\"w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse\" data-kid=\"26\"></span>\n                        SYSTEM_ONLINE\n                    </div>\n                </div>\n            </div>\n        </div>\n    </aside>\n\n    \n    <main class=\"flex-1 overflow-x-hidden p-12 space-y-24 relative\" data-kid=\"27\">\n        \n        <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none z-0\" style=\"background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;\" data-kid=\"28\"></div>\n        \n        \n        <section id=\"hero-stat\" class=\"max-w-7xl mx-auto\" data-kid=\"29\">\n            <div class=\"grid grid-cols-12 gap-8 items-stretch\" data-kid=\"30\">\n                \n                <div class=\"animate-stat col-span-8 bg-white border-3 border-black p-12 relative overflow-hidden shadow-[6px_6px_0_#4285F4,12px_12px_0_#34A853,18px_18px_0_#EA4335,24px_24px_0_#FBBC05]\" data-kid=\"31\">\n                    <div class=\"relative z-10\" data-kid=\"32\">\n                        <p class=\"text-sm font-black uppercase tracking-[0.3em] mb-6 text-black/40\" data-kid=\"33\">Real-Time Efficiency Node</p>\n                        <div class=\"flex items-end gap-8\" data-kid=\"34\">\n                            <h2 class=\"text-[14rem] font-black leading-[0.65] tracking-tighter\" data-kid=\"35\">98.4<span class=\"text-5xl ml-2 font-black\" data-kid=\"36\">%</span></h2>\n                            <div class=\"mb-6\" data-kid=\"37\">\n                                <div class=\"bg-[#34A853] text-white px-4 py-1.5 font-black text-2xl border-2 border-black mb-3\" data-kid=\"38\">+2.1%</div>\n                                <p class=\"font-['Roboto_Mono'] text-[11px] font-bold uppercase opacity-60 leading-tight\" data-kid=\"39\">Sync-Status: STABLE<br data-kid=\"40\">Epoch: 1,402</p>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"absolute -bottom-10 -right-10 opacity-5 pointer-events-none\" data-kid=\"41\">\n                        <i class=\"ti ti-topology-star-3 text-[20rem]\" data-kid=\"42\"></i>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-4 flex flex-col gap-8\" data-kid=\"43\">\n                    <div class=\"animate-stat flex-1 bg-white border-3 border-black p-8 shadow-[8px_8px_0_#4285F4]\" data-kid=\"44\">\n                        <p class=\"text-[10px] font-black uppercase tracking-widest opacity-50 mb-3\" data-kid=\"45\">Live Throughput</p>\n                        <h3 class=\"text-6xl font-black tracking-tighter\" data-kid=\"46\">1.28M</h3>\n                        <p class=\"font-['Roboto_Mono'] text-[10px] font-bold mt-4 uppercase tracking-tight text-[#4285F4]\" data-kid=\"47\">Units per computational cycle</p>\n                    </div>\n                    <div class=\"animate-st