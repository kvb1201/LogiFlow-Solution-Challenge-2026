data-kid=\"170\">\n\n<style data-kid=\"171\">\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@900&family=Roboto+Mono:wght@400;700&display=swap');\n\nbody {\n    background-color: #FDFDFC;\n}\n\n/* Custom shadow for hero metric */\n.shadow-quad {\n    box-shadow: 4px 4px 0 #4285F4, 8px 8px 0 #34A853, 12px 12px 0 #EA4335;\n}\n\n/* Hide scrollbars but keep functionality */\n.no-scrollbar::-webkit-scrollbar {\n    display: none;\n}\n.no-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n}\n\n/* Selection style */\n::selection {\n    background: #000;\n    color: #fff;\n}\n\n/* Hard offset animation class */\n.hard-press:active {\n    transform: translate(4px, 4px);\n    box-shadow: none;\n}\n\n/* Ensure brutalist feel on focus */\n*:focus {\n    outline: 4px solid #FBBC05;\n    outline-offset: 4px;\n}\n</style>\n",
