gap-3\" data-kid=\"52\">\n              <div class=\"w-3 h-3 bg-[#34A853]\" data-kid=\"53\"></div>\n              <span class=\"tracking-widest uppercase\" data-kid=\"54\">Eco_Flow_Stream</span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"55\">\n              <div class=\"w-3 h-3 bg-[#EA4335]\" data-kid=\"56\"></div>\n              <span class=\"tracking-widest uppercase\" data-kid=\"57\">Critical_Failure_Node</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"absolute top-4 right-4 z-20 bg-white border-2 border-[#222] p-2 flex items-center gap-3\" data-kid=\"58\">\n          <div class=\"text-[10px] font-black\" data-kid=\"59\">ZOOM: 1.4X</div>\n          <div class=\"h-4 w-[2px] bg-[#222]\" data-kid=\"60\"></div>\n          <div class=\"text-[10px] font-black\" data-kid=\"61\">LAT: 34.0522° N</div>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-12 lg:col-span-4 flex flex-col gap-8\" data-kid=\"62\">\n        <div class=\"bento-card flex-1 border-4 border-[#222] bg-[#34A853] p-8 text-white flex flex-col justify-between shadow-[12px_12px_0_rgba(34,34,34,1)] relative overflow-hidden\" data-kid=\"63\">\n          <div class=\"absolute top-0 right-0 p-2 opacity-10\" data-kid=\"64\">\n            <i class=\"ti ti-activity text-9xl\" data-kid=\"65\"></i>\n          </div>\n          <div class=\"flex justify-between items-start\" data-kid=\"66\">\n            <span class=\"text-sm font-bold uppercase tracking-[0.2em]\" data-kid=\"67\">Active_Fleet</span>\n            <i class=\"ti ti-truck text-4xl\" data-kid=\"68\"></i>\n          </div>\n          <div data-kid=\"69\">\n            <div class=\"font-['Syne'] text-8xl font-black leading-none tracking-tighter\" data-kid=\"70\">1,402</div>\n            <div class=\"flex items-center gap-2 mt-4\" data-kid=\"71\">\n              <span class=\"text-[10px] font-bold bg-black/30 px-3 py-1 uppercase tracking-widest\" data-kid=\"72\">Efficiency: 98.2%</span>\n              <i class=\"ti ti-arrow-up-right font-black\" data-kid=\"73\"></i>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"bento-card flex-1 border-4 border-[#222] bg-[#EA4335] p-8 text-white flex flex-col justify-between shadow-[12px_12px_0_rgba(34,34,34,1)] relative overflow-hidden\" data-kid=\"74\">\n          <div class=\"absolute top-0 right-0 p-2 opacity-10\" data-kid=\"75\">\n            <i class=\"ti ti-alert-circle text-9xl\" data-kid=\"76\"></i>\n          </div>\n          <div class=\"flex justify-between items-start\" data-kid=\"77\">\n            <span class=\"text-sm font-bold uppercase tracking-[0.2em]\" data-kid=\"78\">Delay_Critical</span>\n            <i class=\"ti ti-alert-triangle text-4xl\" data-kid=\"79\"></i>\n          </div>\n          <div data-kid=\"80\">\n            <div class=\"font-['Syne'] text-8xl font-black leading-none tracking-tighter\" data-kid=\"81\">031</div>\n            <div class=\"flex items-center gap-2 mt-4\" data-kid=\"82\">\n              <span class=\"text-[10px] font-bold bg-black/30 px-3 py-1 uppercase tracking-widest\" data-kid=\"83\">Action_Required</span>\n              <span class=\"animate-ping w-2 h-2 bg-white rounded-full\" data-kid=\"84\"></span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"bento-card col-span-12 border-4 border-[#222] bg-white p-8 shadow-[16px_16px_0_rgba(34,34,34,1)]\" data-kid=\"85\">\n        <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8\" data-kid=\"86\">\n          <div data-kid=\"87\">\n            <h3 class=\"font-['Syne'] text-3xl font-black uppercase tracking-tighter\" data-kid=\"88\">Velocity_Flux_Index</h3>\n            <p class=\"text-[10px] font-bold opacity-60 tracking-widest\" data-kid=\"89\">REAL_TIME_DATA_STREAM_00912</p>\n          </div>\n          <div class=\"flex gap-6\" data-kid=\"90\">\n            <div class