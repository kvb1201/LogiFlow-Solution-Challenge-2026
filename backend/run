#!/bin/bash
cd "$(dirname "$0")"
source venv/bin/activate

# Load environment variables from .env (if present)
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

PY="${VIRTUAL_ENV}/bin/python3.13"
if [ ! -x "$PY" ]; then
  PY="${VIRTUAL_ENV}/bin/python"
fi

exec "$PY" -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
